+				return "ERR WATCH_INCOMPATIBLE_WITH_COVERAGE";
 			std::string mode_text, address_text, length_text, option, extra;
 			input >> mode_text >> address_text >> length_text >> option >> extra;
 			for (auto &ch : mode_text) ch = static_cast<char>(toupper(ch));
@@ -6737,6 +7002,10 @@ static std::string RemoteExecuteCommand(const std::string &request,
 			remote_api_trace_saved_decoder = cpudecoder;
 			cpudecoder = &CPU_Core_Normal_Run;
 		}
+		if (remote_coverage_active && cpudecoder != &CPU_Core_Normal_Run) {
+			remote_coverage_saved_decoder = cpudecoder;
+			cpudecoder = &CPU_Core_Normal_Run;
+		}
 		DOSBOX_SetNormalLoop();
 		resume = true;
 		return "OK RUNNING";
@@ -6755,6 +7024,10 @@ static Bitu RemoteDebuggerLoop(void)
 		cpudecoder = remote_api_trace_saved_decoder;
 		remote_api_trace_saved_decoder = NULL;
 	}
+	if (remote_coverage_saved_decoder) {
+		cpudecoder = remote_coverage_saved_decoder;
+		remote_coverage_saved_decoder = NULL;
+	}
 	CBreakpoint::DeactivateBreakpoints();
 	{
 		std::lock_guard<std::mutex> lock(remote_debug_mutex);
@@ -8578,6 +8851,7 @@ bool DEBUG_HeavyIsBreakpoint(void) {
 		return true;
 	}
 	RemoteApiTraceObserve();
+	RemoteCoverageObserve();
 	if (cpuLog) {
 		if (cpuLogCounter>0) {
 			LogInstruction(SegValue(cs),reg_eip,cpuLogFile);
