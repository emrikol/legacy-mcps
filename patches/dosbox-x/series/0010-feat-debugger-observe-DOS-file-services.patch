+/* Read-only metadata hook for the remote DOS file-service observer. The DOS
+ * layer calls this after each service completes; non-debug builds compile the
+ * calls away below. Values of UINT16_MAX/UINT32_MAX mean no handle is known. */
+enum DEBUG_FileIoOperation {
+	DEBUG_FILEIO_OPEN,
+	DEBUG_FILEIO_CREATE,
+	DEBUG_FILEIO_READ,
+	DEBUG_FILEIO_WRITE,
+	DEBUG_FILEIO_SEEK,
+	DEBUG_FILEIO_RENAME
+};
+
+#if C_DEBUG
+void DEBUG_FileIoObserve(DEBUG_FileIoOperation operation, uint16_t psp,
+                         uint16_t call_cs, uint32_t call_eip,
+                         uint16_t guest_handle, uint32_t system_handle,
+                         bool fcb, const char *path, const char *path2,
+                         bool success, uint16_t error, uint32_t requested,
+                         uint32_t actual, uint32_t seek_origin,
+                         uint32_t seek_argument, uint32_t seek_result);
+void DEBUG_FileIoHandleClosed(uint32_t system_handle);
+#else
+static inline void DEBUG_FileIoObserve(DEBUG_FileIoOperation, uint16_t,
+                                       uint16_t, uint32_t, uint16_t, uint32_t,
+                                       bool, const char *, const char *, bool,
+                                       uint16_t, uint32_t, uint32_t, uint32_t,
+                                       uint32_t, uint32_t) {}
+static inline void DEBUG_FileIoHandleClosed(uint32_t) {}
+#endif
+
 extern Bitu cycle_count;
 extern Bitu debugCallback;
 
