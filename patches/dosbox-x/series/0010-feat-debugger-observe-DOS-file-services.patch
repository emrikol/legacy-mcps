+/* Capture service-entry context without changing the operation. The destructor
+ * records every exit path, including validation failures, after the DOS error
+ * and returned byte counts have reached their final values. */
+class DOSFileIoObservation {
+public:
+	DOSFileIoObservation(DEBUG_FileIoOperation operation_value,
+	                     const char *path_value = NULL,
+	                     const char *path2_value = NULL)
+	        : operation(operation_value), psp(dos.psp()), call_cs(SegValue(cs)),
+	          call_eip(reg_eip), guest_handle(UINT16_MAX),
+	          system_handle(UINT32_MAX), fcb(false),
+	          path(path_value ? path_value : ""),
+	          path2(path2_value ? path2_value : ""), success(false),
+	          requested(0), actual(0), seek_origin(UINT32_MAX),
+	          seek_argument(UINT32_MAX), seek_result(UINT32_MAX) {}
+
+	~DOSFileIoObservation()
+	{
+		DEBUG_FileIoObserve(operation, psp, call_cs, call_eip, guest_handle,
+		                    system_handle, fcb, path.empty() ? NULL : path.c_str(),
+		                    path2.empty() ? NULL : path2.c_str(), success,
+		                    success ? 0 : dos.errorcode, requested, actual,
+		                    seek_origin, seek_argument, seek_result);
+	}
+
+	DEBUG_FileIoOperation operation;
+	uint16_t psp;
+	uint16_t call_cs;
+	uint32_t call_eip;
+	uint16_t guest_handle;
+	uint32_t system_handle;
+	bool fcb;
+	std::string path;
+	std::string path2;
+	bool success;
+	uint32_t requested;
+	uint32_t actual;
+	uint32_t seek_origin;
+	uint32_t seek_argument;
+	uint32_t seek_result;
+};
