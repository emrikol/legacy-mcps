+static std::string RemoteFileIoHexBytes(const std::string &value)
+{
+	if (value.empty()) return "-";
+	std::ostringstream out;
+	out << std::hex << std::uppercase << std::setfill('0');
+	for (const unsigned char byte : value)
+		out << std::setw(2) << static_cast<unsigned int>(byte);
+	return out.str();
+}
+
+static void RemoteFileIoOptionalHex(std::ostringstream &out, bool known,
+	                                uint64_t value, unsigned int width)
+{
+	if (!known) {
+		out << "-";
+		return;
+	}
+	out << std::hex << std::uppercase << std::setfill('0')
+	    << std::setw(width) << value << std::dec;
+}
+
+static std::string RemoteFileIoStatus(void)
+{
+	std::ostringstream out;
+	out << "OK ACTIVE=" << (remote_fileio_active ? 1 : 0)
+	    << " CAPACITY=" << remote_fileio_capacity
+	    << " QUEUED=" << remote_fileio_events.size()
+	    << " DROPPED=" << remote_fileio_dropped
+	    << " NEXT=" << remote_fileio_next_sequence;
+	return out.str();
+}
+
+static std::string RemoteFileIoDrain(size_t count)
+{
+	const size_t drained = std::min(count, remote_fileio_events.size());
+	std::ostringstream out;
+	out << "OK COUNT=" << drained
+	    << " ACTIVE=" << (remote_fileio_active ? 1 : 0)
+	    << " DROPPED=" << remote_fileio_dropped;
+	for (size_t index = 0; index < drained; ++index) {
+		const RemoteFileIoEvent &event = remote_fileio_events.front();
+		out << "\nSEQ=" << event.sequence
+		    << " OP=" << RemoteFileIoOperationName(event.operation)
+		    << " SUCCESS=" << (event.success ? 1 : 0)
+		    << " ERROR=" << std::hex << std::uppercase << std::setfill('0')
+		    << std::setw(4) << event.error
+		    << " PSP=" << std::setw(4) << event.psp
+		    << " SITE=" << std::setw(4) << event.call_cs << ":"
+		    << std::setw(8) << event.call_eip << std::dec
+		    << " GH=";
+		RemoteFileIoOptionalHex(out, event.guest_handle != UINT16_MAX,
+		                        event.guest_handle, 4);
+		out << " SH=";
+		RemoteFileIoOptionalHex(out, event.system_handle != UINT32_MAX,
+		                        event.system_handle, 8);
+		out << " FCB=" << (event.fcb ? 1 : 0)
+		    << " PATH=" << RemoteFileIoHexBytes(event.path)
+		    << " PATH2=" << RemoteFileIoHexBytes(event.path2)
+		    << " BEFORE=";
+		RemoteFileIoOptionalHex(out, event.offset_before_known,
+		                        event.offset_before, 16);
+		out << " AFTER=";
+		RemoteFileIoOptionalHex(out, event.offset_after_known,
+		                        event.offset_after, 16);
+		out << " REQUEST=" << event.requested
+		    << " ACTUAL=" << event.actual
+		    << " ORIGIN=";
+		if (event.seek_origin == UINT32_MAX) out << "-";
+		else out << event.seek_origin;
+		out << " SEEK=";
+		RemoteFileIoOptionalHex(out, event.seek_argument != UINT32_MAX,
+		                        event.seek_argument, 8);
+		remote_fileio_events.pop_front();
+	}
+	return out.str();
+}
