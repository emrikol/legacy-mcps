@@ -5274,6 +5474,61 @@ static std::string RemoteExecuteCommand(const std::string &request,
 
 	if (command == "REGISTERS") return RemoteRegisterState();
 
+	if (command == "FILEIO") {
+		std::string action, value_text, extra;
+		input >> action >> value_text >> extra;
+		for (auto &ch : action) ch = static_cast<char>(toupper(ch));
+		if (action == "STATUS") {
+			if (!value_text.empty()) return "ERR USAGE DEBUG FILEIO STATUS";
+			return RemoteFileIoStatus();
+		}
+		if (action == "START") {
+			if (!extra.empty()) return "ERR USAGE DEBUG FILEIO START [capacity]";
+			size_t capacity = 256;
+			if (!value_text.empty()) {
+				char *end = NULL;
+				const unsigned long parsed = strtoul(value_text.c_str(), &end, 10);
+				if (!end || *end != '\0' || parsed < 16 || parsed > 1024)
+					return "ERR FILEIO_CAPACITY_RANGE_16_1024";
+				capacity = static_cast<size_t>(parsed);
+			}
+			remote_fileio_active = false;
+			remote_fileio_events.clear();
+			remote_fileio_offsets.clear();
+			remote_fileio_capacity = capacity;
+			remote_fileio_next_sequence = 0;
+			remote_fileio_dropped = 0;
+			remote_fileio_active = true;
+			return RemoteFileIoStatus();
+		}
+		if (action == "STOP") {
+			if (!value_text.empty()) return "ERR USAGE DEBUG FILEIO STOP";
+			remote_fileio_active = false;
+			return RemoteFileIoStatus();
+		}
+		if (action == "CLEAR") {
+			if (!value_text.empty()) return "ERR USAGE DEBUG FILEIO CLEAR";
+			remote_fileio_events.clear();
+			remote_fileio_offsets.clear();
+			remote_fileio_next_sequence = 0;
+			remote_fileio_dropped = 0;
+			return RemoteFileIoStatus();
+		}
+		if (action == "DRAIN") {
+			if (!extra.empty()) return "ERR USAGE DEBUG FILEIO DRAIN [count]";
+			size_t count = 8;
+			if (!value_text.empty()) {
+				char *end = NULL;
+				const unsigned long parsed = strtoul(value_text.c_str(), &end, 10);
+				if (!end || *end != '\0' || parsed < 1 || parsed > 8)
+					return "ERR FILEIO_DRAIN_RANGE_1_8";
+				count = static_cast<size_t>(parsed);
+			}
+			return RemoteFileIoDrain(count);
+		}
+		return "ERR USAGE DEBUG FILEIO (START|STATUS|DRAIN|STOP|CLEAR)";
+	}
+
 	if (command == "MUTATE") {
