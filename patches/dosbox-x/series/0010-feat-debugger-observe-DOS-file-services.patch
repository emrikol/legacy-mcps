+struct RemoteFileIoEvent {
+	uint64_t sequence;
+	DEBUG_FileIoOperation operation;
+	uint16_t psp;
+	uint16_t call_cs;
+	uint32_t call_eip;
+	uint16_t guest_handle;
+	uint32_t system_handle;
+	bool fcb;
+	std::string path;
+	std::string path2;
+	bool success;
+	uint16_t error;
+	bool offset_before_known;
+	bool offset_after_known;
+	uint64_t offset_before;
+	uint64_t offset_after;
+	uint32_t requested;
+	uint32_t actual;
+	uint32_t seek_origin;
+	uint32_t seek_argument;
+};
+
+static bool remote_fileio_active = false;
+static size_t remote_fileio_capacity = 256;
+static uint64_t remote_fileio_next_sequence = 0;
+static uint64_t remote_fileio_dropped = 0;
+static std::deque<RemoteFileIoEvent> remote_fileio_events;
+static std::map<uint32_t, uint64_t> remote_fileio_offsets;
+
+static const char *RemoteFileIoOperationName(DEBUG_FileIoOperation operation)
+{
+	switch (operation) {
+	case DEBUG_FILEIO_OPEN: return "OPEN";
+	case DEBUG_FILEIO_CREATE: return "CREATE";
+	case DEBUG_FILEIO_READ: return "READ";
+	case DEBUG_FILEIO_WRITE: return "WRITE";
+	case DEBUG_FILEIO_SEEK: return "SEEK";
+	case DEBUG_FILEIO_RENAME: return "RENAME";
+	default: return "UNKNOWN";
+	}
+}
+
+static std::string RemoteFileIoBoundedPath(const char *path)
+{
+	if (!path) return std::string();
+	size_t length = 0;
+	while (length < 260U && path[length]) ++length;
+	return std::string(path, length);
+}
+
+void DEBUG_FileIoObserve(DEBUG_FileIoOperation operation, uint16_t psp,
+	                     uint16_t call_cs, uint32_t call_eip,
+	                     uint16_t guest_handle, uint32_t system_handle,
+	                     bool fcb, const char *path, const char *path2,
+	                     bool success, uint16_t error, uint32_t requested,
+	                     uint32_t actual, uint32_t seek_origin,
+	                     uint32_t seek_argument, uint32_t seek_result)
+{
+	if (!remote_fileio_active) return;
+	RemoteFileIoEvent event;
+	event.sequence = remote_fileio_next_sequence++;
+	event.operation = operation;
+	event.psp = psp;
+	event.call_cs = call_cs;
+	event.call_eip = call_eip;
+	event.guest_handle = guest_handle;
+	event.system_handle = system_handle;
+	event.fcb = fcb;
+	event.path = RemoteFileIoBoundedPath(path);
+	event.path2 = RemoteFileIoBoundedPath(path2);
+	event.success = success;
+	event.error = success ? 0 : error;
+	event.offset_before_known = false;
+	event.offset_after_known = false;
+	event.offset_before = 0;
+	event.offset_after = 0;
+	event.requested = requested;
+	event.actual = actual;
+	event.seek_origin = seek_origin;
+	event.seek_argument = seek_argument;
+
+	if (system_handle != UINT32_MAX) {
+		const auto known = remote_fileio_offsets.find(system_handle);
+		if (known != remote_fileio_offsets.end()) {
+			event.offset_before_known = true;
+			event.offset_before = known->second;
+		}
+		if (success && (operation == DEBUG_FILEIO_OPEN ||
+		                operation == DEBUG_FILEIO_CREATE)) {
+			event.offset_before_known = true;
+			event.offset_after_known = true;
+			event.offset_before = 0;
+			event.offset_after = 0;
+			remote_fileio_offsets[system_handle] = 0;
+		} else if (success && operation == DEBUG_FILEIO_SEEK &&
+		           seek_result != UINT32_MAX) {
+			event.offset_after_known = true;
+			event.offset_after = seek_result;
+			remote_fileio_offsets[system_handle] = seek_result;
+		} else if (success &&
+		           (operation == DEBUG_FILEIO_READ || operation == DEBUG_FILEIO_WRITE) &&
+		           event.offset_before_known) {
+			event.offset_after_known = true;
+			event.offset_after = event.offset_before + actual;
+			remote_fileio_offsets[system_handle] = event.offset_after;
+		}
+	}
+
+	if (remote_fileio_events.size() >= remote_fileio_capacity) {
+		++remote_fileio_dropped;
+		return;
+	}
+	remote_fileio_events.push_back(event);
+}
+
+void DEBUG_FileIoHandleClosed(uint32_t system_handle)
+{
+	remote_fileio_offsets.erase(system_handle);
+}
