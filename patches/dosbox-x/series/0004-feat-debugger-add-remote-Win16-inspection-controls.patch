+bool CBreakpoint::CheckExceptionBreakpoint(uint8_t vector, uint32_t error)
+{
+	for (auto i = BPoints.begin(); i != BPoints.end(); ++i) {
+		CBreakpoint* bp = *i;
+		if (bp->GetType() != BKPNT_EXCEPTION || !bp->IsActive() ||
+		    bp->GetIntNr() != vector ||
+		    (!bp->ExceptionErrorIsAny() && bp->GetExceptionError() != error))
+			continue;
+		if (bp->GetOnce()) {
+			(BPoints.erase)(i);
+			bp->Activate(false);
+			delete bp;
+		}
+		return true;
+	}
+	return false;
+}
