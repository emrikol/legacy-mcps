+	    << "OK STOPPED=" << (remote_debug_stopped.load() ? 1 : 0)
+	    << " REASON=" << RemoteStopReasonName()
+	    << " CORE=" << (CPU_IsDynamicCore() ? "DYNAMIC" : "NORMAL")
