+static std::string RemoteReadMemory(uint64_t address, uint32_t count)
+{
+	if (address == mem_no_address) return "ERR INVALID_ADDRESS";
+	if (!count || count > 512U) return "ERR COUNT_RANGE_1_512";
+	std::ostringstream out;
+	out << "OK" << std::hex << std::uppercase << std::setfill('0');
+	for (uint32_t i = 0; i < count; ++i) {
+		uint8_t value = 0;
+		if (mem_readb_checked(static_cast<PhysPt>(address + i), &value))
+			return "ERR MEMORY_READ";
+		out << " " << std::setw(2) << static_cast<unsigned int>(value);
+	}
+	return out.str();
+}
+
+static std::string RemoteDisassemble(uint16_t segment, uint32_t offset,
+                                     uint32_t count)
+{
+	if (!count || count > 32U) return "ERR COUNT_RANGE_1_32";
+	std::ostringstream out;
+	out << std::hex << std::uppercase << std::setfill('0');
+	for (uint32_t i = 0; i < count; ++i) {
+		const uint64_t address = GetAddress(segment, offset);
+		if (address == mem_no_address) return "ERR INVALID_ADDRESS";
+		char line[200];
+		const Bitu size = DasmI386(line, static_cast<PhysPt>(address), offset,
+		                           cpu.code.big);
+		if (!size) return "ERR DISASSEMBLY";
+		if (i) out << "\n";
+		out << (i ? "   " : "OK ") << std::setw(4) << segment << ":"
+		    << std::setw(8) << offset << " " << line;
+		offset += static_cast<uint32_t>(size);
+	}
+	return out.str();
+}
+
+static bool RemoteReadSelectorWord(uint16_t selector, uint32_t offset,
+                                   uint16_t &value)
+{
+	if (offset >= 0xffffU) return false;
+	const uint64_t first = GetAddress(selector, offset);
+	const uint64_t last = GetAddress(selector, offset + 1U);
+	if (first == mem_no_address || last == mem_no_address || last != first + 1U)
+		return false;
+	return !mem_readw_checked(static_cast<PhysPt>(first), &value);
+}
