+CBreakpoint* CBreakpoint::FindMatchingPhysBreakpoint(uint16_t seg, uint32_t off,
+                                                     bool once)
+{
+	if (BPoints.empty()) return nullptr;
+#if !C_HEAVY_DEBUG
+	const PhysPt address = GetAddress(seg, off);
+#endif
+	for (auto bp : BPoints) {
+#if C_HEAVY_DEBUG
+		const bool at_location = bp->GetSegment() == seg && bp->GetOffset() == off;
+#else
+		const bool at_location = bp->GetLocation() == address;
+#endif
+		if (bp->GetType() == BKPNT_PHYSICAL && at_location &&
+		    bp->GetOnce() == once && bp->RemoteConditionMatches())
+			return bp;
+	}
+	return nullptr;
+}
