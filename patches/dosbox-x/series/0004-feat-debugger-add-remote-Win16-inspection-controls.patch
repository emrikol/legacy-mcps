+static std::string RemoteWin16Stack(uint32_t count)
+{
+	if (!count || count > 64U) return "ERR STACK_COUNT_RANGE_1_64";
+	if (cpu.stack.big) return "ERR STACK_REQUIRES_16BIT_STACK";
+
+	const uint16_t stack_selector = SegValue(ss);
+	uint16_t frame_bp = reg_bp;
+	uint16_t frame_cs = SegValue(cs);
+	uint32_t frame_ip = reg_eip;
+	std::set<uint16_t> visited;
+	std::string end_reason = "LIMIT";
+	std::ostringstream out;
+	out << std::hex << std::uppercase << std::setfill('0')
+	    << "OK 0:CURRENT:" << std::setw(4) << frame_cs << ":"
+	    << std::setw(8) << frame_ip << ":SS=" << std::setw(4) << stack_selector
+	    << ":BP=" << std::setw(4) << frame_bp;
+
+	for (uint32_t index = 1; index < count; ++index) {
+		if (!frame_bp) {
+			end_reason = "ZERO_BP";
+			break;
+		}
+		if (!visited.insert(frame_bp).second) {
+			end_reason = "CYCLE";
+			break;
+		}
+		/* Saved BP and return IP occupy four bytes even for a near frame. */
+		if (frame_bp > 0xfffcU) {
+			end_reason = "FRAME_RANGE";
+			break;
+		}
+		uint16_t saved_bp = 0;
+		uint16_t return_ip = 0;
+		uint16_t return_cs = frame_cs;
+		if (!RemoteReadSelectorWord(stack_selector, frame_bp, saved_bp) ||
+		    !RemoteReadSelectorWord(stack_selector, frame_bp + 2U, return_ip)) {
+			end_reason = "UNREADABLE";
+			break;
+		}
+		const bool far_frame = (saved_bp & 1U) != 0;
+		if (far_frame) {
+			if (frame_bp > 0xfffaU) {
+				end_reason = "FRAME_RANGE";
+				break;
+			}
+			if (!RemoteReadSelectorWord(stack_selector, frame_bp + 4U, return_cs)) {
+				end_reason = "UNREADABLE";
+				break;
+			}
+		}
+		const uint16_t parent_bp = far_frame ?
+		                           static_cast<uint16_t>(saved_bp - 1U) : saved_bp;
+		out << ";" << std::dec << index << std::hex << ":RETURN:"
+		    << std::setw(4) << return_cs << ":" << std::setw(8) << return_ip
+		    << ":SS=" << std::setw(4) << stack_selector
+		    << ":BP=" << std::setw(4) << parent_bp
+		    << ":VIA=" << (far_frame ? "FAR" : "NEAR");
+		frame_bp = parent_bp;
+		frame_cs = return_cs;
+	}
+
+	out << " END=" << end_reason;
+	return out.str();
+}
+
+static void RemoteStepOneInstruction(bool inhibit_events = false)
+{
+	/* Dynamic cores execute translated blocks even when given a one-cycle
+	 * budget. Use the normal decoder for this one instruction, then restore the
+	 * configured decoder so execution between debugger stops remains fast. */
+	CPU_Decoder *configured_decoder = cpudecoder;
+	if (CPU_IsDynamicCore()) cpudecoder = &CPU_Core_Normal_Run;
+	exitLoop = false;
+	mustCompleteInstruction = true;
+	inhibit_int_breakpoint = inhibit_events;
+	inhibit_exception_breakpoint = inhibit_events;
+	DEBUG_Run(1, true);
+	inhibit_exception_breakpoint = false;
+	inhibit_int_breakpoint = false;
+	mustCompleteInstruction = false;
+	cpudecoder = configured_decoder;
+}
