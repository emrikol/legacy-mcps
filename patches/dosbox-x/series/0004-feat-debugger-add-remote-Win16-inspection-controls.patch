+static bool RemoteParseHex(const std::string &text, uint32_t &value)
+{
+	if (text.empty()) return false;
+	char *end = NULL;
+	unsigned long parsed = strtoul(text.c_str(), &end, 16);
+	if (!end || *end != '\0' || parsed > 0xffffffffUL) return false;
+	value = static_cast<uint32_t>(parsed);
+	return true;
+}
+
+static bool RemoteParseInterruptFilter(std::string text, uint16_t &value)
+{
+	for (auto &ch : text) ch = static_cast<char>(toupper(ch));
+	if (text.empty() || text == "ANY") {
+		value = BPINT_ALL;
+		return true;
+	}
+	uint32_t parsed = 0;
+	if (!RemoteParseHex(text, parsed) || parsed > 0xffU) return false;
+	value = static_cast<uint16_t>(parsed);
+	return true;
+}
+
+static ERemoteConditionRegister RemoteParseConditionRegister(std::string text)
+{
+	for (auto &ch : text) ch = static_cast<char>(toupper(ch));
+#define REMOTE_REGISTER(name) if (text == #name) return REMOTE_REG_##name
+	REMOTE_REGISTER(EAX); REMOTE_REGISTER(EBX); REMOTE_REGISTER(ECX); REMOTE_REGISTER(EDX);
+	REMOTE_REGISTER(ESI); REMOTE_REGISTER(EDI); REMOTE_REGISTER(EBP); REMOTE_REGISTER(ESP);
+	REMOTE_REGISTER(EIP); REMOTE_REGISTER(CS); REMOTE_REGISTER(SS); REMOTE_REGISTER(DS);
+	REMOTE_REGISTER(ES); REMOTE_REGISTER(FS); REMOTE_REGISTER(GS); REMOTE_REGISTER(FLAGS);
+	REMOTE_REGISTER(AX); REMOTE_REGISTER(BX); REMOTE_REGISTER(CX); REMOTE_REGISTER(DX);
+	REMOTE_REGISTER(SI); REMOTE_REGISTER(DI); REMOTE_REGISTER(BP); REMOTE_REGISTER(SP);
+	REMOTE_REGISTER(IP); REMOTE_REGISTER(AH); REMOTE_REGISTER(AL); REMOTE_REGISTER(BH);
+	REMOTE_REGISTER(BL); REMOTE_REGISTER(CH); REMOTE_REGISTER(CL); REMOTE_REGISTER(DH);
+	REMOTE_REGISTER(DL);
+#undef REMOTE_REGISTER
+	return REMOTE_REG_NONE;
+}
+
+static ERemoteConditionOperator RemoteParseConditionOperator(std::string text)
+{
+	for (auto &ch : text) ch = static_cast<char>(toupper(ch));
+	if (text == "=" || text == "==" || text == "EQ") return REMOTE_CONDITION_EQ;
+	if (text == "!=" || text == "NE") return REMOTE_CONDITION_NE;
+	if (text == "<" || text == "LT") return REMOTE_CONDITION_LT;
+	if (text == "<=" || text == "LE") return REMOTE_CONDITION_LE;
+	if (text == ">" || text == "GT") return REMOTE_CONDITION_GT;
+	if (text == ">=" || text == "GE") return REMOTE_CONDITION_GE;
+	if (text == "&" || text == "MASK_SET") return REMOTE_CONDITION_MASK_SET;
+	if (text == "!&" || text == "MASK_CLEAR") return REMOTE_CONDITION_MASK_CLEAR;
+	return REMOTE_CONDITION_NONE;
+}
+
+static bool RemoteParseAddress(const std::string &text, uint16_t &segment,
+                               uint32_t &offset)
+{
+	const std::string::size_type colon = text.find(':');
+	if (colon == std::string::npos) return false;
+	uint32_t parsed_segment = 0;
+	if (!RemoteParseHex(text.substr(0, colon), parsed_segment) ||
+	    parsed_segment > 0xffffU ||
+	    !RemoteParseHex(text.substr(colon + 1), offset)) return false;
+	segment = static_cast<uint16_t>(parsed_segment);
+	return true;
+}
