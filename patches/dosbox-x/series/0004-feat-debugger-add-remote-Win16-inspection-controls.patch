+	    << " ECX=" << std::setw(8) << reg_ecx
+	    << " EDX=" << std::setw(8) << reg_edx
+	    << " ESI=" << std::setw(8) << reg_esi
+	    << " EDI=" << std::setw(8) << reg_edi
+	    << " EBP=" << std::setw(8) << reg_ebp
+	    << " ESP=" << std::setw(8) << reg_esp
+	    << " CS=" << std::setw(4) << SegValue(cs)
+	    << " EIP=" << std::setw(8) << reg_eip
+	    << " SS=" << std::setw(4) << SegValue(ss)
