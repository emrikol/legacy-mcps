+bool CBreakpoint::RemoteConditionMatches(void) const
+{
+	if (!HasRemoteCondition()) return true;
+	const uint32_t actual = RemoteConditionRegisterValue(conditionRegister);
+	switch (conditionOperator) {
+	case REMOTE_CONDITION_EQ: return actual == conditionValue;
+	case REMOTE_CONDITION_NE: return actual != conditionValue;
+	case REMOTE_CONDITION_LT: return actual < conditionValue;
+	case REMOTE_CONDITION_LE: return actual <= conditionValue;
+	case REMOTE_CONDITION_GT: return actual > conditionValue;
+	case REMOTE_CONDITION_GE: return actual >= conditionValue;
+	case REMOTE_CONDITION_MASK_SET: return (actual & conditionValue) != 0;
+	case REMOTE_CONDITION_MASK_CLEAR: return (actual & conditionValue) == 0;
+	default: return false;
+	}
+}
+
+std::string CBreakpoint::RemoteConditionText(void) const
+{
+	if (!HasRemoteCondition()) return std::string();
+	std::ostringstream out;
+	out << ":IF:" << RemoteConditionRegisterName(conditionRegister)
+	    << ":" << RemoteConditionOperatorName(conditionOperator)
+	    << ":" << std::hex << std::uppercase << std::setfill('0')
+	    << std::setw(8) << conditionValue;
+	return out.str();
+}
 
