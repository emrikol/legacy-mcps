+				--nested_depth;
+			}
+		}
+		return "ERR FINISH_INSTRUCTION_LIMIT";
+	}
+
+	if (command == "NEXT" || command == "RUN") {
+		std::string subcommand, address_text;
+		if (command == "RUN") {
+			input >> subcommand >> address_text;
+			for (auto &ch : subcommand) ch = static_cast<char>(toupper(ch));
+			if (subcommand != "UNTIL")
+				return "ERR USAGE DEBUG RUN UNTIL <selector:offset>";
+			uint16_t segment = 0;
+			uint32_t offset = 0;
+			if (!RemoteParseAddress(address_text, segment, offset))
+				return "ERR INVALID_ADDRESS";
+			CBreakpoint::AddBreakpoint(segment, offset, true);
+		} else {
+			const PhysPt start = static_cast<PhysPt>(GetAddress(SegValue(cs), reg_eip));
+			char line[200];
+			const Bitu size = DasmI386(line, start, reg_eip, cpu.code.big);
+			std::string disassembly(line);
+			for (auto &ch : disassembly) ch = static_cast<char>(tolower(ch));
+			if (disassembly.find("call") != std::string::npos ||
+			    disassembly.find("int") != std::string::npos ||
+			    disassembly.find("loop") != std::string::npos ||
+			    disassembly.find("rep") != std::string::npos) {
+				CBreakpoint::AddBreakpoint(SegValue(cs), reg_eip + size, true);
+			} else {
+				RemoteStepOneInstruction();
+				remote_debug_stop_reason.store(REMOTE_STOP_NEXT);
+				return RemoteRegisterState();
+			}
+		}
+		command = "CONTINUE";
+	}
+
+	if (command == "CONTINUE") {
+		const int previous_reason = remote_debug_stop_reason.load();
+		const bool resuming_event = previous_reason == REMOTE_STOP_INTERRUPT ||
+		                            previous_reason == REMOTE_STOP_EXCEPTION;
+		remote_debug_stop_reason.store(REMOTE_STOP_RUNNING);
+		remote_debug_stopped.store(false);
+		/* Keep every other breakpoint active during the instruction that leaves
+		 * the current stop. Only the physical breakpoint at the current address
+		 * must stay disabled, and only a stopped event needs one-shot event
+		 * inhibition to avoid immediately reporting itself again. */
+		CBreakpoint::ActivateBreakpointsExceptAt(
+		        static_cast<PhysPt>(GetAddress(SegValue(cs), reg_eip)));
+		RemoteStepOneInstruction(resuming_event);
+		CBreakpoint::ActivateBreakpoints();
+		DOSBOX_SetNormalLoop();
+		resume = true;
+		return "OK RUNNING";
+	}
+
+	return "ERR UNKNOWN_DEBUG_COMMAND";
+}
+
+static Bitu RemoteDebuggerLoop(void)
+{
+	CBreakpoint::DeactivateBreakpoints();
+	{
+		std::lock_guard<std::mutex> lock(remote_debug_mutex);
+		remote_debug_stopped.store(true);
+		remote_debug_cv.notify_all();
+	}
+
+	for (;;) {
+		std::string request;
+		{
+			std::unique_lock<std::mutex> lock(remote_debug_mutex);
+			remote_debug_cv.wait(lock, [] { return remote_debug_request_pending; });
+			request = remote_debug_request;
+		}
+
+		bool resume = false;
+		const std::string response = RemoteExecuteCommand(request, resume);
+		{
+			std::lock_guard<std::mutex> lock(remote_debug_mutex);
+			remote_debug_response = response;
+			remote_debug_request_pending = false;
+			remote_debug_response_ready = true;
+			remote_debug_cv.notify_all();
+		}
+		if (resume) return 0;
+	}
+}
+
+bool DEBUG_RemoteCommand(const char *command, char *response,
+                         unsigned int response_size,
+                         unsigned int timeout_ms)
+{
+	if (!command || !response || response_size < 2) return false;
+	const std::string request(command);
+	std::istringstream input(request);
+	std::string verb;
+	input >> verb;
+	for (auto &ch : verb) ch = static_cast<char>(toupper(ch));
+	const auto timeout = std::chrono::milliseconds(timeout_ms ? timeout_ms : 5000);
+	std::unique_lock<std::mutex> lock(remote_debug_mutex);
+
+	if (verb == "STATUS") {
+		remote_debug_response = remote_debug_stopped.load() ?
+		                        RemoteRegisterState() : "OK STOPPED=0 REASON=RUNNING";
+	} else if (verb == "PAUSE") {
+		remote_debug_enabled.store(true);
+		if (!remote_debug_stopped.load()) {
+			remote_debug_stop_reason.store(REMOTE_STOP_PAUSE);
+			remote_pause_requested.store(true);
+			if (!remote_debug_cv.wait_for(lock, timeout, [] {
+				return remote_debug_stopped.load();
+			})) {
+				remote_debug_response = "ERR PAUSE_TIMEOUT";
+				goto copy_response;
+			}
+		}
+		remote_debug_response = RemoteRegisterState();
+	} else if (verb == "WAIT") {
+		if (!remote_debug_cv.wait_for(lock, timeout, [] {
+			return remote_debug_stopped.load();
+		})) {
+			remote_debug_response = "ERR WAIT_TIMEOUT";
+			goto copy_response;
+		}
+		remote_debug_response = RemoteRegisterState();
+	} else {
+		if (!remote_debug_stopped.load()) {
+			remote_debug_response = "ERR NOT_STOPPED";
+			goto copy_response;
+		}
+		if (!remote_debug_cv.wait_for(lock, timeout, [] {
+			return !remote_debug_request_pending;
+		})) {
+			remote_debug_response = "ERR BUSY";
+			goto copy_response;
+		}
+		remote_debug_request = request;
+		remote_debug_response_ready = false;
+		remote_debug_request_pending = true;
+		remote_debug_cv.notify_all();
+		if (!remote_debug_cv.wait_for(lock, timeout, [] {
+			return remote_debug_response_ready;
+		})) {
+			remote_debug_response = "ERR COMMAND_TIMEOUT";
+			goto copy_response;
+		}
+	}
+
+copy_response:
+	snprintf(response, response_size, "%s\n", remote_debug_response.c_str());
+	return remote_debug_response.compare(0, 3, "ERR") != 0;
+}
