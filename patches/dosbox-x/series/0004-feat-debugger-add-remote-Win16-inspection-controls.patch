+std::string CBreakpoint::RemoteList(void)
+{
+	std::ostringstream out;
+	unsigned int index = 0;
+	for (auto bp : BPoints) {
+		if (index) out << ";";
+		out << index++ << ":";
+		switch (bp->GetType()) {
+		case BKPNT_PHYSICAL:
+			out << "EXEC:" << std::hex << std::uppercase << std::setfill('0')
+			    << std::setw(4) << bp->GetSegment() << ":"
+			    << std::setw(8) << bp->GetOffset();
+			break;
+		case BKPNT_INTERRUPT:
+			out << "INT:" << std::hex << std::uppercase << std::setfill('0')
+			    << std::setw(2) << static_cast<unsigned int>(bp->GetIntNr())
+			    << ":AH=";
+			if (bp->GetValue() == BPINT_ALL) out << "ANY";
+			else out << std::setw(2) << bp->GetValue();
+			out << ":AL=";
+			if (bp->GetOther() == BPINT_ALL) out << "ANY";
+			else out << std::setw(2) << bp->GetOther();
+			break;
+		case BKPNT_EXCEPTION:
+			out << "EXCEPTION:" << std::hex << std::uppercase << std::setfill('0')
+			    << std::setw(2) << static_cast<unsigned int>(bp->GetIntNr())
+			    << ":ERROR=";
+			if (bp->ExceptionErrorIsAny()) out << "ANY";
+			else out << std::setw(8) << bp->GetExceptionError();
+			break;
+		case BKPNT_MEMORY_PROT:
+			out << "CHANGE_PROT:" << std::hex << std::uppercase << std::setfill('0')
+			    << std::setw(4) << bp->GetSegment() << ":"
+			    << std::setw(8) << bp->GetOffset();
+			break;
+		case BKPNT_MEMORY_LINEAR:
+			out << "CHANGE_LINEAR:" << std::hex << std::uppercase
+			    << std::setfill('0') << std::setw(8) << bp->GetOffset();
+			break;
+		default:
+			out << "TYPE" << static_cast<int>(bp->GetType());
+			break;
+		}
+		out << ":" << (bp->IsActive() ? "ACTIVE" : "INACTIVE")
+		    << (bp->GetOnce() ? ":ONCE" : "")
+		    << bp->RemoteConditionText();
+	}
+	return index ? out.str() : std::string("EMPTY");
+}
