From 5ed7d743bb8b78ed0d0b4151a442ea0e7614a68f Mon Sep 17 00:00:00 2001
From: Derrick Tennant <derrick.tennant@automattic.com>
Date: Sat, 15 Aug 2026 15:28:49 -0400
Subject: [PATCH 05/19] feat(control): expose debugger and window minimize

---
 build-macos                       | 24 ++++++++---------
 src/gui/dosbox_control_server.cpp | 43 +++++++++++++++++++++++++++++++
 src/gui/sdlmain.cpp               | 15 +++++++++++
 3 files changed, 70 insertions(+), 12 deletions(-)

diff --git a/build-macos b/build-macos
index 400a667..1ce9ade 100755
--- a/build-macos
+++ b/build-macos
@@ -87,8 +87,8 @@ for arch in ${architectures}; do
     (cd vs/sdl && ./build-dosbox.sh) || exit 1
     new="-I${top}/vs/sdl/linux-host/include "
     nld="-L${top}/vs/sdl/linux-host/lib "
-    LDFLAGS="${LDFLAGS}${nld}"
-    CPPFLAGS="${CPPFLAGS}${new}"
+    LDFLAGS="${LDFLAGS} ${nld}"
+    CPPFLAGS="${CPPFLAGS} ${new}"
     export LDFLAGS CPPFLAGS
 
     # prefer to compile against our own copy of SDLnet 1.x
@@ -100,24 +100,24 @@ for arch in ${architectures}; do
     (cd vs/zlib && ./build-dosbox.sh) || exit 1
     new="-I${top}/vs/zlib/linux-host/include "
     nld="-L${top}/vs/zlib/linux-host/lib "
-    LDFLAGS="${LDFLAGS}${nld}"
-    CPPFLAGS="${CPPFLAGS}${new}"
+    LDFLAGS="${LDFLAGS} ${nld}"
+    CPPFLAGS="${CPPFLAGS} ${new}"
 
     # prefer to compile against our own libpng (comment this out to disable)
     echo "Compiling our internal libpng"
     (cd vs/libpng && ./build-dosbox.sh) || exit 1
     new="-I${top}/vs/libpng/linux-host/include "
     nld="-L${top}/vs/libpng/linux-host/lib "
-    LDFLAGS="${LDFLAGS}${nld}"
-    CPPFLAGS="${CPPFLAGS}${new}"
+    LDFLAGS="${LDFLAGS} ${nld}"
+    CPPFLAGS="${CPPFLAGS} ${new}"
 
     # prefer to compile against our own freetype
     echo "Compiling our internal freetype"
     (cd vs/freetype && ./build-dosbox.sh) || exit 1
     new="-I${top}/vs/freetype/linux-host/include/freetype2 "
     nld="-L${top}/vs/freetype/linux-host/lib -lfreetype "
-    LDFLAGS="${LDFLAGS}${nld}"
-    CPPFLAGS="${CPPFLAGS}${new}"
+    LDFLAGS="${LDFLAGS} ${nld}"
+    CPPFLAGS="${CPPFLAGS} ${new}"
     INTERNAL_FREETYPE=1
     export CFLAGS LDFLAGS CPPFLAGS CXXFLAGS INTERNAL_FREETYPE
 
@@ -128,10 +128,10 @@ for arch in ${architectures}; do
         echo "Brew is installed, I'm going to use its libraries too"
         new="-I$(${!brew_cmd} --prefix)/include "
         nld="-L$(${!brew_cmd} --prefix)/lib "
-        CFLAGS="${CFLAGS}${new}"
-        LDFLAGS="${LDFLAGS}${nld}"
-        CPPFLAGS="${CPPFLAGS}${new}"
-        CXXFLAGS="${CXXFLAGS}${new}"
+        CFLAGS="${CFLAGS} ${new}"
+        LDFLAGS="${LDFLAGS} ${nld}"
+        CPPFLAGS="${CPPFLAGS} ${new}"
+        CXXFLAGS="${CXXFLAGS} ${new}"
         PKG_CONFIG_PATH="${PKG_CONFIG_PATH}:$(${!brew_cmd} --prefix)/lib/pkgconfig"
         export CFLAGS LDFLAGS CPPFLAGS CXXFLAGS PKG_CONFIG_PATH
     fi
diff --git a/src/gui/dosbox_control_server.cpp b/src/gui/dosbox_control_server.cpp
index db123b6..cb1fad7 100644
--- a/src/gui/dosbox_control_server.cpp
+++ b/src/gui/dosbox_control_server.cpp
@@ -8,6 +8,7 @@
  *   SCREENSHOT [path]  - Capture screen to PNG, respond with path
  *   SCREEN             - Read VGA text buffer (80x25), returns lines separated by \n
  *   STATUS             - Return emulator status
+ *   DEBUG <command>    - Thread-safe remote CPU debugger
  *   QUIT               - Shut down DOSBox-X
  *   PING               - Liveness check, returns PONG
  *
@@ -36,6 +37,7 @@
 #include "vga.h"
 #include "keyboard.h"
 #include "bios.h"
+#include "debug.h"
 
 /* Externs */
 extern Bitu CaptureState;
@@ -60,6 +62,10 @@ static std::atomic<bool> click_requested(false);
 static std::atomic<bool> click_done(false);
 static int click_x = 0, click_y = 0;
 
+/* Host-window requests are dispatched by the SDL main thread. */
+static std::atomic<int> window_action_requested(0);
+static std::atomic<bool> window_action_done(false);
+
 /* Public interface for hardware.cpp to check */
 bool ControlServer_ScreenshotRequested() {
     return screenshot_requested.load();
@@ -111,6 +117,15 @@ void ControlServer_DispatchClick() {
     click_done.store(true);
 }
 
+int ControlServer_WindowActionRequested() {
+    return window_action_requested.load();
+}
+
+void ControlServer_WindowActionComplete() {
+    window_action_requested.store(0);
+    window_action_done.store(true);
+}
+
 static std::string handle_command(const std::string& cmd) {
     /* Trim trailing whitespace */
     std::string c = cmd;
@@ -129,6 +144,34 @@ static std::string handle_command(const std::string& cmd) {
         return std::string(buf);
     }
 
+    if (c == "MINIMIZE") {
+        window_action_done.store(false);
+        window_action_requested.store(1);
+        for (int i = 0; i < 20 && !window_action_done.load(); i++) {
+            usleep(100000);
+        }
+        return window_action_done.load() ? "OK MINIMIZED\n" : "ERR TIMEOUT\n";
+    }
+
+    if (c == "DEBUG" || c.compare(0, 6, "DEBUG ") == 0) {
+#if C_DEBUG
+        const std::string debug_command = c.length() > 6 ? c.substr(6) : "STATUS";
+        unsigned int timeout_ms = 30000;
+        if (debug_command.compare(0, 5, "WAIT ") == 0) {
+            char *end = NULL;
+            unsigned long requested = strtoul(debug_command.c_str() + 5, &end, 10);
+            if (end && *end == '\0' && requested >= 1 && requested <= 300000)
+                timeout_ms = static_cast<unsigned int>(requested);
+        }
+        char response[16384];
+        DEBUG_RemoteCommand(debug_command.c_str(), response,
+                            sizeof(response), timeout_ms);
+        return std::string(response);
+#else
+        return "ERR DEBUGGER_NOT_COMPILED\n";
+#endif
+    }
+
     if (c.substr(0, 10) == "SCREENSHOT") {
         /* Optional path argument */
         if (c.length() > 11) {
diff --git a/src/gui/sdlmain.cpp b/src/gui/sdlmain.cpp
index 5c2a901..029bb55 100644
--- a/src/gui/sdlmain.cpp
+++ b/src/gui/sdlmain.cpp
@@ -5873,6 +5873,21 @@ bool gfx_in_mapper = false;
 #endif
 
 void GFX_Events() {
+    /* Keep host-window management on SDL's main thread. Automated VM runs
+     * minimize the emulator without host GUI scripting or hiding it. */
+    {
+        extern int ControlServer_WindowActionRequested();
+        extern void ControlServer_WindowActionComplete();
+        if (ControlServer_WindowActionRequested() == 1) {
+#if defined(C_SDL2)
+            if (sdl.window != NULL) SDL_MinimizeWindow(sdl.window);
+#else
+            SDL_WM_IconifyWindow();
+#endif
+            ControlServer_WindowActionComplete();
+        }
+    }
+
     /* Dispatch any pending control server mouse clicks on the main thread
      * (before poll skip check so clicks aren't rate-limited) */
     {
