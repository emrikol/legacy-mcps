+/* Selector translation is defined with the debugger helpers below. */
+uint64_t GetAddress(uint16_t seg, uint32_t offset);
+
 /* A bounded, non-stopping probe records entry stack bytes at exact protected-
  * mode addresses. Host plans attach Win16 message/API meaning; the emulator
  * deliberately knows nothing about USER/GDI calling conventions. */
@@ -528,6 +536,7 @@ struct RemoteApiTraceProbe {
 
 struct RemoteApiTraceEvent {
 	uint64_t sequence;
+	uint64_t instruction_sequence;
 	unsigned int probe_id;
 	uint16_t cs;
 	uint32_t eip;
@@ -545,6 +554,12 @@ static std::vector<RemoteApiTraceProbe> remote_api_trace_probes;
 static std::deque<RemoteApiTraceEvent> remote_api_trace_events;
 static CPU_Decoder *remote_api_trace_saved_decoder = NULL;
 
+/* FILEIO callbacks execute below the CPU dispatch boundary while APITRACE
+ * probes execute at instruction entry. A shared monotonically increasing
+ * instruction sequence lets the host establish their exact order without
+ * pretending that the real-mode DOS service stack is a Win16 task stack. */
+static uint64_t remote_observer_instruction_sequence = 0;
+
 /* Code coverage is deliberately an address collector, not a disassembler.
  * A reviewed host plan gives exact Win16 basic-block boundaries meaning; the
  * emulator only records which instruction addresses actually executed inside
@@ -604,8 +619,62 @@ static std::string RemoteFileIoBoundedPath(const char *path)
 	return std::string(path, length);
 }
 
+static void RemoteFileIoCaptureCallers(RemoteFileIoEvent &event)
+{
+	if (cpu.stack.big) {
+		event.call_stack_end = "32BIT_STACK";
+		return;
+	}
+	uint16_t frame_bp = static_cast<uint16_t>(event.call_ebp);
+	uint16_t frame_cs = event.call_cs;
+	std::set<uint16_t> visited;
+	event.call_stack_end = "LIMIT";
+	for (size_t index = 0; index < 16U; ++index) {
+		if (!frame_bp) {
+			event.call_stack_end = "ZERO_BP";
+			break;
+		}
+		if (!visited.insert(frame_bp).second) {
+			event.call_stack_end = "CYCLE";
+			break;
+		}
+		if (frame_bp > 0xfffcU) {
+			event.call_stack_end = "FRAME_RANGE";
+			break;
+		}
+		const uint64_t bp_address = GetAddress(event.call_ss, frame_bp);
+		const uint64_t ip_address = GetAddress(event.call_ss, frame_bp + 2U);
+		uint16_t saved_bp = 0;
+		uint16_t return_ip = 0;
+		if (bp_address == (~0ULL) || ip_address != bp_address + 2U ||
+		    mem_readw_checked(static_cast<PhysPt>(bp_address), &saved_bp) ||
+		    mem_readw_checked(static_cast<PhysPt>(ip_address), &return_ip)) {
+			event.call_stack_end = "UNREADABLE";
+			break;
+		}
+		const bool far_frame = (saved_bp & 1U) != 0;
+		uint16_t return_cs = frame_cs;
+		if (far_frame) {
+			if (frame_bp > 0xfffaU) {
+				event.call_stack_end = "FRAME_RANGE";
+				break;
+			}
+			const uint64_t cs_address = GetAddress(event.call_ss, frame_bp + 4U);
+			if (cs_address != bp_address + 4U ||
+			    mem_readw_checked(static_cast<PhysPt>(cs_address), &return_cs)) {
+				event.call_stack_end = "UNREADABLE";
+				break;
+			}
+		}
+		event.callers.push_back(std::make_pair(return_cs, return_ip));
+		frame_bp = far_frame ? static_cast<uint16_t>(saved_bp - 1U) : saved_bp;
+		frame_cs = return_cs;
+	}
+}
