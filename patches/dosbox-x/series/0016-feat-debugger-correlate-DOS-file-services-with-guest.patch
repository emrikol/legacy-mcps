 void DEBUG_FileIoObserve(DEBUG_FileIoOperation operation, uint16_t psp,
 	                     uint16_t call_cs, uint32_t call_eip,
+	                     uint16_t call_ss, uint32_t call_ebp,
 	                     uint16_t guest_handle, uint32_t system_handle,
 	                     bool fcb, const char *path, const char *path2,
 	                     bool success, uint16_t error, uint32_t requested,
@@ -615,10 +684,14 @@ void DEBUG_FileIoObserve(DEBUG_FileIoOperation operation, uint16_t psp,
 	if (!remote_fileio_active) return;
 	RemoteFileIoEvent event;
 	event.sequence = remote_fileio_next_sequence++;
+	event.instruction_sequence = remote_observer_instruction_sequence;
 	event.operation = operation;
 	event.psp = psp;
 	event.call_cs = call_cs;
 	event.call_eip = call_eip;
+	event.call_ss = call_ss;
+	event.call_ebp = call_ebp;
+	RemoteFileIoCaptureCallers(event);
 	event.guest_handle = guest_handle;
 	event.system_handle = system_handle;
 	event.fcb = fcb;
@@ -5407,13 +5480,24 @@ static std::string RemoteFileIoDrain(size_t count)
 	for (size_t index = 0; index < drained; ++index) {
 		const RemoteFileIoEvent &event = remote_fileio_events.front();
 		out << "\nSEQ=" << event.sequence
+		    << " ISEQ=" << event.instruction_sequence
 		    << " OP=" << RemoteFileIoOperationName(event.operation)
 		    << " SUCCESS=" << (event.success ? 1 : 0)
 		    << " ERROR=" << std::hex << std::uppercase << std::setfill('0')
 		    << std::setw(4) << event.error
 		    << " PSP=" << std::setw(4) << event.psp
 		    << " SITE=" << std::setw(4) << event.call_cs << ":"
-		    << std::setw(8) << event.call_eip << std::dec
+		    << std::setw(8) << event.call_eip
+		    << " SS:BP=" << std::setw(4) << event.call_ss << ":"
+		    << std::setw(8) << event.call_ebp
+		    << " CALLERS=";
+		if (event.callers.empty()) out << "-";
+		else for (size_t caller_index = 0; caller_index < event.callers.size(); ++caller_index) {
+			if (caller_index) out << ",";
+			out << std::setw(4) << event.callers[caller_index].first << ":"
+			    << std::setw(8) << event.callers[caller_index].second;
+		}
+		out << " STACKEND=" << event.call_stack_end << std::dec
 		    << " GH=";
 		RemoteFileIoOptionalHex(out, event.guest_handle != UINT16_MAX,
 		                        event.guest_handle, 4);
@@ -5464,6 +5548,7 @@ static std::string RemoteApiTraceDrain(size_t count)
 	for (size_t index = 0; index < drained; ++index) {
 		const RemoteApiTraceEvent &event = remote_api_trace_events.front();
 		out << "\nSEQ=" << event.sequence
+		    << " ISEQ=" << event.instruction_sequence
 		    << " ID=" << event.probe_id
 		    << " SITE=" << std::hex << std::uppercase << std::setfill('0')
 		    << std::setw(4) << event.cs << ":" << std::setw(8) << event.eip
@@ -5524,6 +5609,7 @@ static void RemoteApiTraceObserve(void)
 		if (probe.selector != SegValue(cs) || probe.offset != reg_eip) continue;
 		RemoteApiTraceEvent event;
 		event.sequence = remote_api_trace_next_sequence++;
+		event.instruction_sequence = remote_observer_instruction_sequence;
 		event.probe_id = probe.id;
 		event.cs = SegValue(cs);
 		event.eip = reg_eip;
@@ -6334,6 +6420,7 @@ static std::string RemoteExecuteCommand(const std::string &request,
 			remote_fileio_capacity = capacity;
 			remote_fileio_next_sequence = 0;
 			remote_fileio_dropped = 0;
+			if (!remote_api_trace_active) remote_observer_instruction_sequence = 0;
 			remote_fileio_active = true;
 			return RemoteFileIoStatus();
 		}
@@ -6411,6 +6498,7 @@ static std::string RemoteExecuteCommand(const std::string &request,
 			remote_api_trace_capacity = static_cast<size_t>(capacity);
 			remote_api_trace_next_sequence = 0;
 			remote_api_trace_dropped = 0;
+			if (!remote_fileio_active) remote_observer_instruction_sequence = 0;
 			remote_api_trace_active = true;
 			return RemoteApiTraceStatus();
 		}
@@ -8848,6 +8936,8 @@ void DEBUG_HeavyWriteLogInstruction(void) {
 }
 
