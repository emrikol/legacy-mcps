+static void RemoteDeterminismFail(const char *reason)
+{
+	if (remote_determinism_failed) return;
+	remote_determinism_failed = true;
+	remote_determinism_failure = reason;
+	/* Keep VERIFY armed until the heavy-debug boundary stops execution. This
+	 * suppresses live IRQ/NMI delivery during the one loop transition needed
+	 * to enter the debugger after a fail-closed mismatch. */
+	if (remote_determinism_mode != REMOTE_DETERMINISM_VERIFY) {
+		remote_determinism_mode = REMOTE_DETERMINISM_OFF;
+		DEBUG_determinism_active = false;
+	}
+}
+
+static bool RemoteDeterminismMatches(const RemoteDeterminismEvent &expected,
+	                                  const RemoteDeterminismEvent &actual)
+{
+	return expected.kind == actual.kind && expected.sequence == actual.sequence &&
+	       expected.path == actual.path &&
+	       expected.offset_known == actual.offset_known &&
+	       (!expected.offset_known || expected.offset == actual.offset) &&
+	       expected.success == actual.success && expected.error == actual.error &&
+	       expected.requested == actual.requested &&
+	       expected.bytes == actual.bytes && expected.vector == actual.vector;
+}
+
+static void RemoteDeterminismObserve(const RemoteDeterminismEvent &event)
+{
+	if (remote_determinism_mode == REMOTE_DETERMINISM_OFF) return;
+	if (remote_determinism_mode == REMOTE_DETERMINISM_RECORD) {
+		if (remote_determinism_events.size() >= remote_determinism_event_capacity ||
+		    event.bytes.size() > remote_determinism_byte_capacity - remote_determinism_bytes) {
+			RemoteDeterminismFail("CAPACITY");
+			return;
+		}
+		remote_determinism_bytes += event.bytes.size();
+		remote_determinism_events.push_back(event);
+		return;
+	}
+	if (remote_determinism_cursor >= remote_determinism_events.size()) {
+		RemoteDeterminismFail("UNEXPECTED_EVENT");
+		return;
+	}
+	if (!RemoteDeterminismMatches(remote_determinism_events[remote_determinism_cursor],
+	                              event)) {
+		RemoteDeterminismFail("EVENT_MISMATCH");
+		return;
+	}
+	++remote_determinism_cursor;
+}
+
+int DEBUG_DeterminismInterruptDecision(uint8_t vector, bool nmi)
+{
+	if (remote_determinism_mode == REMOTE_DETERMINISM_OFF) return 1;
+	RemoteDeterminismEvent event = {};
+	event.kind = nmi ? REMOTE_DETERMINISM_NMI : REMOTE_DETERMINISM_IRQ;
+	event.sequence = remote_replay_sequence;
+	event.vector = vector;
+	event.cs = SegValue(cs);
+	event.eip = reg_eip;
+	event.cpu_hash = RemoteDeterminismCpuHash();
+	if (remote_determinism_mode == REMOTE_DETERMINISM_RECORD) {
+		RemoteDeterminismObserve(event);
+		return remote_determinism_failed ? -1 : 1;
+	}
+	/* VERIFY holds the real pending request. The retired-boundary hook validates
+	 * and acknowledges it only at the retained delivery sequence. */
+	return 0;
+}
