+		const uint8_t irq = static_cast<uint8_t>(vector - slave.vector_base);
+		const uint8_t bit = static_cast<uint8_t>(1U << irq);
+		const uint8_t cascade_bit = static_cast<uint8_t>(1U << master_cascade_irq);
+		if (!(slave.irr & bit) || !(master.irr & cascade_bit)) return false;
+		slave.start_irq(irq);
+		master.start_irq(master_cascade_irq);
+		CPU_HW_Interrupt(vector);
+		return true;
+	}
+	if (vector >= master.vector_base && vector < master.vector_base + 8U) {
+		const uint8_t irq = static_cast<uint8_t>(vector - master.vector_base);
+		if (!(master.irr & static_cast<uint8_t>(1U << irq))) return false;
+		master.start_irq(irq);
+		CPU_HW_Interrupt(vector);
+		return true;
