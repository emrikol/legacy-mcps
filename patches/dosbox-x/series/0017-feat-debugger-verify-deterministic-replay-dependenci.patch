+{
+	if (nmi) {
+		/* Replay bypasses CPU_NMI_Interrupt's live-delivery observer because the
+		 * retained NMI event has already been validated and consumed here. */
+		if (CPU_NMI_active || !CPU_NMI_pending) return false;
+		CPU_NMI_active = true;
+		CPU_NMI_pending = false;
+		CPU_Interrupt(2, 0, reg_eip);
+		return true;
+	}
