+static std::string RemoteDeterminismStatus()
+{
+	const char *mode = remote_determinism_mode == REMOTE_DETERMINISM_RECORD ?
+	                         "RECORD" :
+	                   remote_determinism_mode == REMOTE_DETERMINISM_VERIFY ?
+	                         "VERIFY" : "OFF";
+	std::ostringstream out;
+	out << "OK MODE=" << mode << " SEQUENCE=" << remote_replay_sequence
+	    << " LOG_VALID=" << (remote_determinism_log_valid ? 1 : 0)
+	    << " EVENTS=" << remote_determinism_events.size()
+	    << " CURSOR=" << remote_determinism_cursor
+	    << " BYTES=" << remote_determinism_bytes
+	    << " FAILED=" << (remote_determinism_failed ? 1 : 0)
+	    << " CLOCK=EMULATED_RESTORED SYNC_TIME=" << (sync_time ? 1 : 0)
+	    << " FAILURE="
+	    << (remote_determinism_failure.empty() ? "-" : remote_determinism_failure);
+	if (remote_determinism_cursor < remote_determinism_events.size()) {
+		const RemoteDeterminismEvent &next =
+		        remote_determinism_events[remote_determinism_cursor];
+		const char *kind = next.kind == REMOTE_DETERMINISM_READ ? "READ" :
+		                   next.kind == REMOTE_DETERMINISM_IRQ ? "IRQ" : "NMI";
+		out << " NEXT_KIND=" << kind << " NEXT_SEQUENCE=" << next.sequence;
+		if (next.kind != REMOTE_DETERMINISM_READ)
+			out << " NEXT_VECTOR=" << static_cast<unsigned int>(next.vector);
+	}
+	return out.str();
+}
