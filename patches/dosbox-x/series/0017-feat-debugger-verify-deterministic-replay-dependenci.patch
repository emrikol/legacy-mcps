+static uint64_t RemoteDeterminismCpuHash()
+{
+	FillFlags();
+	uint64_t hash = UINT64_C(14695981039346656037);
+	const uint64_t values[] = {
+		reg_eax, reg_ebx, reg_ecx, reg_edx, reg_esi, reg_edi, reg_ebp, reg_esp,
+		reg_eip, reg_flags, SegValue(cs), SegValue(ss), SegValue(ds), SegValue(es),
+		SegValue(fs), SegValue(gs), Keyb_ig_status()
+	};
+	const unsigned int widths[] = {4,4,4,4,4,4,4,4,4,4,2,2,2,2,2,2,4};
+	for (size_t index = 0; index < sizeof(values) / sizeof(values[0]); ++index)
+		for (unsigned int byte = 0; byte < widths[index]; ++byte) {
+			hash ^= static_cast<uint8_t>(values[index] >> (byte * 8U));
+			hash *= UINT64_C(1099511628211);
+		}
+	return hash;
+}
