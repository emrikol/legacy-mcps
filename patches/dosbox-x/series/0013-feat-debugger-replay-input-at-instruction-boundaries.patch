+static bool RemoteParseDecimalSequence(const std::string &text, uint64_t &value)
+{
+	if (text.empty() || text.size() > 20U) return false;
+	value = 0;
+	for (const auto ch : text) {
+		if (!isdigit(static_cast<unsigned char>(ch))) return false;
+		const uint64_t digit = static_cast<uint64_t>(ch - '0');
+		if (value > (UINT64_MAX - digit) / 10U) return false;
+		value = value * 10U + digit;
+	}
+	return true;
+}
+
+static KBD_KEYS RemoteReplayKey(const std::string &raw_name)
+{
+	std::string name = raw_name;
+	for (auto &ch : name) ch = static_cast<char>(toupper(ch));
+	static const struct { const char *name; KBD_KEYS key; } names[] = {
+		{"ENTER", KBD_enter}, {"ESC", KBD_esc}, {"TAB", KBD_tab},
+		{"SPACE", KBD_space}, {"BACKSPACE", KBD_backspace},
+		{"DELETE", KBD_delete}, {"INSERT", KBD_insert}, {"HOME", KBD_home},
+		{"END", KBD_end}, {"PGUP", KBD_pageup}, {"PGDN", KBD_pagedown},
+		{"LEFT", KBD_left}, {"RIGHT", KBD_right}, {"UP", KBD_up},
+		{"DOWN", KBD_down}, {"LALT", KBD_leftalt}, {"RALT", KBD_rightalt},
+		{"LCTRL", KBD_leftctrl}, {"RCTRL", KBD_rightctrl},
+		{"LSHIFT", KBD_leftshift}, {"RSHIFT", KBD_rightshift},
+		{"F1", KBD_f1}, {"F2", KBD_f2}, {"F3", KBD_f3}, {"F4", KBD_f4},
+		{"F5", KBD_f5}, {"F6", KBD_f6}, {"F7", KBD_f7}, {"F8", KBD_f8},
+		{"F9", KBD_f9}, {"F10", KBD_f10}, {"F11", KBD_f11}, {"F12", KBD_f12}
+	};
+	for (const auto &entry : names)
+		if (name == entry.name) return entry.key;
+	if (name.size() == 1U) {
+		const char ch = name[0];
+		if (ch >= '1' && ch <= '9') return static_cast<KBD_KEYS>(KBD_1 + ch - '1');
+		if (ch == '0') return KBD_0;
+		static const KBD_KEYS letters[] = {
+			KBD_a, KBD_b, KBD_c, KBD_d, KBD_e, KBD_f, KBD_g, KBD_h, KBD_i,
+			KBD_j, KBD_k, KBD_l, KBD_m, KBD_n, KBD_o, KBD_p, KBD_q, KBD_r,
+			KBD_s, KBD_t, KBD_u, KBD_v, KBD_w, KBD_x, KBD_y, KBD_z
+		};
+		if (ch >= 'A' && ch <= 'Z') return letters[ch - 'A'];
+	}
+	return KBD_NONE;
+}
+
+static std::string RemoteReplayInputRecord(const RemoteReplayInput &input)
+{
+	std::ostringstream out;
+	out << "SEQ=" << input.sequence;
+	if (input.kind == REMOTE_INPUT_KEY) {
+		out << " TYPE=KEY VALUE=" << input.value
+		    << " STATE=" << (input.pressed ? "DOWN" : "UP");
+	} else if (input.kind == REMOTE_INPUT_MOUSE_MOVE) {
+		out << " TYPE=MOUSE_MOVE X=" << input.x << " Y=" << input.y;
+	} else {
+		out << " TYPE=MOUSE_LEFT STATE=" << (input.pressed ? "DOWN" : "UP");
+	}
+	return out.str();
+}
+
+static std::string RemoteReplayInputAdd(const RemoteReplayInput &input)
+{
+	static const size_t maximum_inputs = 256U;
+	static const uint64_t maximum_lead = UINT64_C(10000000);
+	if (!remote_replay_active) return "ERR CHECKPOINT_REQUIRED";
+	if (input.sequence <= remote_replay_sequence ||
+	    input.sequence - remote_replay_sequence > maximum_lead)
+		return "ERR INPUT_SEQUENCE_RANGE_NEXT_10000000";
+	if (remote_replay_input_log.size() >= maximum_inputs)
+		return "ERR INPUT_LOG_FULL_256";
+	if (!remote_replay_input_log.empty() &&
+	    input.sequence < remote_replay_input_log.back().sequence)
+		return "ERR INPUT_SEQUENCE_NOT_MONOTONIC";
+	remote_replay_input_log.push_back(input);
+	remote_replay_pending_inputs.push_back(input);
+	return "OK ADDED " + RemoteReplayInputRecord(input);
+}
+
+static std::string RemoteReplayInputStatus()
+{
+	std::ostringstream out;
+	out << "OK ACTIVE=" << (remote_replay_active ? 1 : 0)
+	    << " SEQUENCE=" << remote_replay_sequence
+	    << " LOGGED=" << remote_replay_input_log.size()
+	    << " PENDING=" << remote_replay_pending_inputs.size()
+	    << " SKIPPED=" << remote_replay_skipped_inputs
+	    << " BOUNDARY=AFTER_RETIRE_BEFORE_NEXT";
+	return out.str();
+}
+
+static std::string RemoteReplayInputLog()
+{
+	std::ostringstream out;
+	out << "OK COUNT=" << remote_replay_input_log.size();
+	for (const auto &input : remote_replay_input_log)
+		out << "\n" << RemoteReplayInputRecord(input)
+		    << " BOUNDARY_PASSED="
+		    << (input.sequence <= remote_replay_sequence ? 1 : 0);
+	return out.str();
+}
+
+static std::string RemoteReplayInputs()
+{
+	if (!remote_replay_active) return "ERR CHECKPOINT_REQUIRED";
+	if (!remote_replay_pending_inputs.empty()) return "ERR INPUT_PENDING_NOT_EMPTY";
+	if (remote_replay_skipped_inputs != 0U) return "ERR INPUT_LOG_HAS_SKIPPED";
+	for (const auto &input : remote_replay_input_log)
+		if (input.sequence > remote_replay_sequence)
+			remote_replay_pending_inputs.push_back(input);
+	std::ostringstream out;
+	out << "OK REPLAYED=" << remote_replay_pending_inputs.size()
+	    << " FROM_SEQUENCE=" << remote_replay_sequence;
+	return out.str();
+}
