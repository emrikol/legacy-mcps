+					if (!extra.empty())
+						return "ERR USAGE DEBUG INPUT ADD <sequence> MOUSE MOVE <x> <y>";
+					replay_input.kind = REMOTE_INPUT_MOUSE_MOVE;
+					replay_input.x = static_cast<uint16_t>(x);
+					replay_input.y = static_cast<uint16_t>(y);
+					return RemoteReplayInputAdd(replay_input);
+				}
+				if (operation == "LEFT") {
+					std::string state;
+					input >> state >> extra;
+					for (auto &ch : state) ch = static_cast<char>(toupper(ch));
+					if ((state != "DOWN" && state != "UP") || !extra.empty())
+						return "ERR USAGE DEBUG INPUT ADD <sequence> MOUSE LEFT <DOWN|UP>";
+					replay_input.kind = REMOTE_INPUT_MOUSE_BUTTON;
+					replay_input.pressed = state == "DOWN";
+					return RemoteReplayInputAdd(replay_input);
+				}
