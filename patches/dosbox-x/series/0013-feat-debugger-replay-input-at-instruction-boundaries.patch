+#if C_DEBUG
+/* Deterministic replay calls these on the emulator thread at an exact normal-
+ * core instruction boundary. Unlike the legacy control CLICK command, no SDL
+ * queue, host timer, or worker-thread sleep lies between the sequence and the
+ * guest mouse state transition. Coordinates are DOSBox-X window pixels. */
+static uint16_t replay_mouse_x = 0;
+static uint16_t replay_mouse_y = 0;
+
+void GFX_GetReplayMousePosition(uint16_t &x, uint16_t &y)
+{
+	x = replay_mouse_x;
+	y = replay_mouse_y;
+}
+
+void GFX_SetReplayMousePosition(uint16_t x, uint16_t y)
+{
+	replay_mouse_x = x;
+	replay_mouse_y = y;
+}
+
+void GFX_ReplayMouseMove(uint16_t x, uint16_t y)
+{
+	SDL_MouseMotionEvent motion;
+	memset(&motion, 0, sizeof(motion));
+	motion.x = x;
+	motion.y = y;
+	motion.xrel = static_cast<Sint16>(static_cast<int32_t>(x) - replay_mouse_x);
+	motion.yrel = static_cast<Sint16>(static_cast<int32_t>(y) - replay_mouse_y);
+	replay_mouse_x = x;
+	replay_mouse_y = y;
+	HandleMouseMotion(&motion);
+}
+
+void GFX_ReplayMouseButton(bool pressed)
+{
+	SDL_MouseButtonEvent button;
+	SDL_MouseMotionEvent motion;
+	memset(&button, 0, sizeof(button));
+	memset(&motion, 0, sizeof(motion));
+	button.button = SDL_BUTTON_LEFT;
+	button.state = pressed ? SDL_PRESSED : SDL_RELEASED;
+	button.x = replay_mouse_x;
+	button.y = replay_mouse_y;
+	motion.x = replay_mouse_x;
+	motion.y = replay_mouse_y;
+	HandleMouseButton(&button, &motion);
+}
+#endif
