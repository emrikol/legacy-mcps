+static void RemoteReplayDeliverInputs()
+{
+	/* Never inject late. A missed boundary is a replay-integrity failure, so
+	 * discard it visibly instead of blocking every later queued event forever. */
+	while (!remote_replay_pending_inputs.empty() &&
+	       remote_replay_pending_inputs.front().sequence < remote_replay_sequence) {
+		remote_replay_pending_inputs.pop_front();
+		++remote_replay_skipped_inputs;
+	}
+	while (!remote_replay_pending_inputs.empty() &&
+	       remote_replay_pending_inputs.front().sequence == remote_replay_sequence) {
+		const RemoteReplayInput input = remote_replay_pending_inputs.front();
+		remote_replay_pending_inputs.pop_front();
+		if (input.kind == REMOTE_INPUT_KEY) {
+			KEYBOARD_AddKey(static_cast<KBD_KEYS>(input.value), input.pressed);
+		} else if (input.kind == REMOTE_INPUT_MOUSE_MOVE) {
+			void GFX_ReplayMouseMove(uint16_t x, uint16_t y);
+			GFX_ReplayMouseMove(input.x, input.y);
+		} else {
+			void GFX_ReplayMouseButton(bool pressed);
+			GFX_ReplayMouseButton(input.pressed);
+		}
+	}
+}
+
 void DEBUG_RemoteInstructionRetired(void)
 {
-	if (remote_replay_active) ++remote_replay_sequence;
+	if (!remote_replay_active) return;
+	++remote_replay_sequence;
+	RemoteReplayDeliverInputs();
 }
 
