+			for (auto &ch : kind) ch = static_cast<char>(toupper(ch));
+			uint64_t sequence = 0;
+			if (!RemoteParseDecimalSequence(sequence_text, sequence))
+				return "ERR INVALID_INPUT_SEQUENCE";
+			RemoteReplayInput replay_input = {};
+			replay_input.sequence = sequence;
+			if (kind == "KEY") {
+				std::string key_name, state;
+				input >> key_name >> state >> extra;
+				for (auto &ch : state) ch = static_cast<char>(toupper(ch));
+				const KBD_KEYS key = RemoteReplayKey(key_name);
+				if (key == KBD_NONE) return "ERR INVALID_INPUT_KEY";
+				if ((state != "DOWN" && state != "UP") || !extra.empty())
+					return "ERR USAGE DEBUG INPUT ADD <sequence> KEY <key> <DOWN|UP>";
+				replay_input.kind = REMOTE_INPUT_KEY;
+				replay_input.value = static_cast<uint16_t>(key);
+				replay_input.pressed = state == "DOWN";
