 }
 
+static bool RemoteCheckpointNameIsValid(const std::string &name)
+{
+	if (name.empty() || name.size() > 32U ||
+	    !isalnum(static_cast<unsigned char>(name[0])) ||
+	    name.find("..") != std::string::npos) return false;
+	for (const auto ch : name) {
+		if (!isalnum(static_cast<unsigned char>(ch)) && ch != '-' &&
+		    ch != '_' && ch != '.') return false;
+	}
+	return true;
+}
+
+static std::string RemoteCheckpointPath(const std::string &name)
+{
+	extern std::string capturedir;
+	std::string directory;
+	bool Get_Custom_SaveDir(std::string &savedir);
+	if (!Get_Custom_SaveDir(directory)) {
+		const size_t slash = capturedir.find_last_of("\\/");
+		directory = slash == std::string::npos ? "." : capturedir.substr(0, slash);
+		directory += CROSS_FILESPLIT;
+		directory += "save";
+	}
+	Cross::CreateDir(directory);
+	directory += CROSS_FILESPLIT;
+	directory += "remote-replay";
+	Cross::CreateDir(directory);
+	return directory + CROSS_FILESPLIT + name + ".sav";
+}
+
+static bool RemoteCheckpointFileExists(const std::string &path)
+{
+	std::ifstream input(path.c_str(), std::ifstream::in | std::ifstream::binary);
+	if (!input.good()) return false;
+	input.seekg(0, std::ifstream::end);
+	return input.good() && input.tellg() > 0;
+}
+
+static bool RemoteCheckpointRemoveExisting(const std::string &path)
+{
+	/* SaveState has early returns before its own remove(). Proactively remove a
+	 * stale archive and prove the directory entry is gone before saving. */
+	(void)remove(path.c_str());
+	std::ifstream input(path.c_str(), std::ifstream::in | std::ifstream::binary);
+	return !input.good();
+}
+
+static bool RemoteCheckpointArchiveMatches(const std::string &path,
+                                            uint64_t expected_sequence)
+{
+	unzFile archive = unzOpen64(path.c_str());
+	if (archive == NULL) return false;
+
+	bool matches = false;
+	if (unzLocateFile(archive, "Remote_Replay", 1) == UNZ_OK &&
+	    unzOpenCurrentFile(archive) == UNZ_OK) {
+		uint32_t magic = 0;
+		bool active = false;
+		uint64_t sequence = 0;
+		const int magic_bytes = unzReadCurrentFile(archive, &magic, sizeof(magic));
+		const int active_bytes = unzReadCurrentFile(archive, &active, sizeof(active));
+		const int sequence_bytes =
+		        unzReadCurrentFile(archive, &sequence, sizeof(sequence));
+		uint8_t extra = 0;
+		const int extra_bytes = unzReadCurrentFile(archive, &extra, sizeof(extra));
+		const int member_close = unzCloseCurrentFile(archive);
+		matches = magic_bytes == static_cast<int>(sizeof(magic)) &&
+		          active_bytes == static_cast<int>(sizeof(active)) &&
+		          sequence_bytes == static_cast<int>(sizeof(sequence)) &&
+		          extra_bytes == 0 && member_close == UNZ_OK &&
+		          magic == UINT32_C(0x52525031) && active &&
+		          sequence == expected_sequence;
+	}
+	return unzClose(archive) == UNZ_OK && matches;
+}
+
+static std::string RemotePerformCheckpointAction()
+{
+	const RemoteCheckpointAction action = remote_checkpoint_action;
+	const std::string name = remote_checkpoint_name;
+	remote_checkpoint_action = REMOTE_CHECKPOINT_NONE;
+	remote_checkpoint_name.clear();
+	if (action == REMOTE_CHECKPOINT_NONE) return "ERR NO_CHECKPOINT_ACTION";
+
+	(void)RemoteReplayStateComponent();
+	const std::string path = RemoteCheckpointPath(name);
+	extern bool use_save_file, noremark_save_state, force_load_state;
+	extern std::string savefilename;
+	const bool old_use_save_file = use_save_file;
+	const bool old_noremark = noremark_save_state;
+	const bool old_force_load = force_load_state;
+	const std::string old_savefilename = savefilename;
+	use_save_file = true;
+	noremark_save_state = true;
+	force_load_state = false;
+	savefilename = path;
+
+	std::string result;
+	if (action == REMOTE_CHECKPOINT_SAVE) {
+		const bool old_replay_active = remote_replay_active;
+		remote_replay_save_component_written = false;
+		if (!RemoteCheckpointRemoveExisting(path)) {
+			result = "ERR CHECKPOINT_STALE_REMOVE_FAILED";
+		} else {
+			remote_replay_active = true;
+			SaveState::instance().save(0);
+			if (remote_replay_save_component_written &&
+			    RemoteCheckpointArchiveMatches(path, remote_replay_sequence))
+				result = "OK CHECKPOINT=SAVED NAME=" + name +
+				         " SEQUENCE=" + std::to_string(remote_replay_sequence);
+			else if (!RemoteCheckpointRemoveExisting(path))
+				result = "ERR CHECKPOINT_SAVE_FAILED_CLEANUP_FAILED";
+			else
+				result = "ERR CHECKPOINT_SAVE_FAILED";
+		}
+		if (result.compare(0, 3, "ERR") == 0)
+			remote_replay_active = old_replay_active;
+	} else if (!RemoteCheckpointFileExists(path)) {
+		result = "ERR CHECKPOINT_NOT_FOUND";
+	} else {
+		remote_replay_load_component_seen = false;
+		SaveState::instance().load(0);
+		if (!remote_replay_load_component_seen) {
+			/* DOSBox-X's load API cannot roll back a partially read archive. Keep the
+			 * debugger stopped and make the uncertain state explicit. */
+			result = "ERR CHECKPOINT_RESTORE_FAILED STATE_UNCERTAIN_STOPPED=1";
+		} else {
+			remote_replay_active = true;
+			result = "OK CHECKPOINT=RESTORED NAME=" + name +
+			         " SEQUENCE=" + std::to_string(remote_replay_sequence);
+		}
+	}
+
+	use_save_file = old_use_save_file;
+	noremark_save_state = old_noremark;
+	force_load_state = old_force_load;
+	savefilename = old_savefilename;
+	return result;
+}
+
+static void RemoteHashByte(uint64_t &hash, uint8_t value)
+{
+	hash ^= value;
+	hash *= UINT64_C(1099511628211);
+}
+
+static void RemoteHashValue(uint64_t &hash, uint64_t value,
+	                        unsigned int byte_count)
+{
+	for (unsigned int byte = 0; byte < byte_count; ++byte)
+		RemoteHashByte(hash, static_cast<uint8_t>(value >> (byte * 8U)));
+}
+
+static std::string RemoteGuestStateHash(uint16_t selector, uint32_t offset,
+	                                    uint32_t count)
+{
+	if (!count || count > 0x10000U || offset > 0xffffffffU - (count - 1U))
+		return "ERR HASH_COUNT_RANGE_1_10000";
+	const uint64_t first = GetAddress(selector, offset);
+	const uint64_t last = GetAddress(selector, offset + count - 1U);
+	if (first == mem_no_address || last == mem_no_address ||
+	    last != first + count - 1U || last > 0xffffffffU)
+		return "ERR INVALID_ADDRESS";
+
+	FillFlags();
+	uint64_t hash = UINT64_C(14695981039346656037);
+	RemoteHashValue(hash, reg_eax, 4); RemoteHashValue(hash, reg_ebx, 4);
+	RemoteHashValue(hash, reg_ecx, 4); RemoteHashValue(hash, reg_edx, 4);
+	RemoteHashValue(hash, reg_esi, 4); RemoteHashValue(hash, reg_edi, 4);
+	RemoteHashValue(hash, reg_ebp, 4); RemoteHashValue(hash, reg_esp, 4);
+	RemoteHashValue(hash, reg_eip, 4); RemoteHashValue(hash, reg_flags, 4);
+	RemoteHashValue(hash, SegValue(cs), 2); RemoteHashValue(hash, SegValue(ss), 2);
+	RemoteHashValue(hash, SegValue(ds), 2); RemoteHashValue(hash, SegValue(es), 2);
+	RemoteHashValue(hash, SegValue(fs), 2); RemoteHashValue(hash, SegValue(gs), 2);
+	for (uint32_t index = 0; index < count; ++index) {
+		uint8_t value = 0;
+		if (mem_readb_checked(static_cast<PhysPt>(first + index), &value))
+			return "ERR MEMORY_READ";
+		RemoteHashByte(hash, value);
+	}
+
+	std::ostringstream out;
+	out << "OK HASH=FNV1A64:" << std::hex << std::uppercase << std::setfill('0')
+	    << std::setw(16) << hash << " SEQUENCE=" << std::dec
+	    << remote_replay_sequence << " ADDRESS=" << std::hex << std::setw(4)
+	    << selector << ":" << std::setw(8) << offset << " COUNT="
+	    << std::setw(8) << count;
+	return out.str();
+}
