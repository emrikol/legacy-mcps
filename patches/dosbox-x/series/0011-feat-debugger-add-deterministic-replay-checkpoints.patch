+/* Deterministic replay foundation. A named checkpoint request is parsed while
+ * stopped, then executed by RemoteDebuggerLoop after the parser returns. This
+ * keeps SaveState load/save outside the command dispatcher and on the emulator
+ * thread, matching the mapper's supported save-state execution context. */
+static bool remote_replay_active = false;
+static uint64_t remote_replay_sequence = 0;
+static bool remote_replay_save_component_written = false;
+static bool remote_replay_load_component_seen = false;
+enum RemoteCheckpointAction {
+	REMOTE_CHECKPOINT_NONE,
+	REMOTE_CHECKPOINT_SAVE,
+	REMOTE_CHECKPOINT_RESTORE
+};
+static RemoteCheckpointAction remote_checkpoint_action = REMOTE_CHECKPOINT_NONE;
+static std::string remote_checkpoint_name;
+
+class RemoteReplaySaveState : public SaveState::Component {
+public:
+	RemoteReplaySaveState()
+	{
+		SaveState::instance().registerComponent("Remote_Replay", *this);
+	}
+
+	void getBytes(std::ostream &stream) override
+	{
+		const uint32_t magic = UINT32_C(0x52525031); /* "RRP1" */
+		writePOD(stream, magic);
+		writePOD(stream, remote_replay_active);
+		writePOD(stream, remote_replay_sequence);
+		remote_replay_save_component_written = stream.good();
+	}
+
+	void setBytes(std::istream &stream) override
+	{
+		uint32_t magic = 0;
+		bool active = false;
+		uint64_t sequence = 0;
+		readPOD(stream, magic);
+		readPOD(stream, active);
+		readPOD(stream, sequence);
+		if (!stream.good() || magic != UINT32_C(0x52525031)) return;
+		remote_replay_active = active;
+		remote_replay_sequence = sequence;
+		remote_replay_load_component_seen = true;
+	}
+};
+
+static RemoteReplaySaveState &RemoteReplayStateComponent()
+{
+	static RemoteReplaySaveState component;
+	return component;
+}
+
+void DEBUG_RemoteInstructionRetired(void)
+{
+	if (remote_replay_active) ++remote_replay_sequence;
+}
