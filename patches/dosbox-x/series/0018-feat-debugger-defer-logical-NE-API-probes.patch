 	    << " NEXT=" << remote_api_trace_next_sequence;
@@ -5766,6 +5802,15 @@ static std::string RemoteApiTraceDrain(size_t count)
 			for (const auto byte : event.stack)
 				out << std::setw(2) << static_cast<unsigned int>(byte);
 		}
+		if (event.logical) {
+			out << " LSEG=" << std::setw(4) << event.logical_segment
+			    << std::dec << " EPOCH=" << event.binding_epoch
+			    << " BASE=" << std::hex << std::uppercase << std::setfill('0')
+			    << std::setw(8) << event.binding_base
+			    << " LIMIT=" << std::setw(8) << event.binding_limit
+			    << " SIGNATURE=FNV1A64:" << std::setw(16)
+			    << event.binding_signature;
