 	mustCompleteInstruction = false;
@@ -5148,6 +5245,98 @@ static std::string RemoteExecuteCommand(const std::string &request,
 		return "OK ADDED";
 	}
 
+	if (command == "WATCH") {
+		std::string action;
+		input >> action;
+		for (auto &ch : action) ch = static_cast<char>(toupper(ch));
+		if (action == "LIST") {
+			std::string extra;
+			input >> extra;
+			if (!extra.empty()) return "ERR USAGE DEBUG WATCH LIST";
+			if (remote_watchpoints.empty()) return "OK EMPTY";
+			std::ostringstream out;
+			out << "OK" << std::hex << std::uppercase << std::setfill('0');
+			for (const auto &watchpoint : remote_watchpoints)
+				out << " " << std::dec << watchpoint.id << ":"
+				    << RemoteWatchModeName(watchpoint.mode) << ":"
+				    << std::hex << std::setw(8) << watchpoint.address << ":"
+				    << std::setw(8) << watchpoint.length
+				    << (watchpoint.once ? ":ONCE" : "");
+			return out.str();
+		}
+		if (action == "CLEAR") {
+			std::string extra;
+			input >> extra;
+			if (!extra.empty()) return "ERR USAGE DEBUG WATCH CLEAR";
+			remote_watchpoints.clear();
+			return "OK CLEARED";
+		}
+		if (action == "DELETE") {
+			std::string id_text, extra;
+			input >> id_text >> extra;
+			char *end = NULL;
+			const unsigned long id = strtoul(id_text.c_str(), &end, 10);
+			if (id_text.empty() || !end || *end != '\0' || !id || !extra.empty())
+				return "ERR USAGE DEBUG WATCH DELETE <decimal-id>";
+			for (auto iterator = remote_watchpoints.begin();
+			     iterator != remote_watchpoints.end(); ++iterator) {
+				if (iterator->id == id) {
+					remote_watchpoints.erase(iterator);
+					return "OK DELETED";
+				}
+			}
+			return "ERR NOT_FOUND";
+		}
+		if (action == "ADD") {
+			std::string mode_text, address_text, length_text, option, extra;
+			input >> mode_text >> address_text >> length_text >> option >> extra;
+			for (auto &ch : mode_text) ch = static_cast<char>(toupper(ch));
+			for (auto &ch : option) ch = static_cast<char>(toupper(ch));
+			RemoteWatchMode mode;
+			if (mode_text == "READ") mode = REMOTE_WATCH_READ;
+			else if (mode_text == "WRITE") mode = REMOTE_WATCH_WRITE;
+			else if (mode_text == "ACCESS") mode = REMOTE_WATCH_ACCESS;
+			else if (mode_text == "CHANGE") mode = REMOTE_WATCH_CHANGE;
+			else return "ERR INVALID_WATCH_MODE";
+			uint16_t segment = 0;
+			uint32_t offset = 0;
+			uint32_t length = 0;
+			if (!RemoteParseAddress(address_text, segment, offset))
+				return "ERR INVALID_ADDRESS";
+			if (!RemoteParseHex(length_text, length) || !length || length > 512U)
+				return "ERR WATCH_LENGTH_RANGE_1_200";
+			if (offset > 0xffffffffU - (length - 1U)) return "ERR INVALID_ADDRESS";
+			const uint64_t first = GetAddress(segment, offset);
+			const uint64_t last = GetAddress(segment, offset + length - 1U);
+			if (first == mem_no_address || last == mem_no_address ||
+			    last != first + length - 1U || first > 0xffffffffU)
+				return "ERR INVALID_ADDRESS";
+			const bool once = option == "ONCE";
+			if ((!option.empty() && !once) || !extra.empty())
+				return "ERR USAGE DEBUG WATCH ADD <READ|WRITE|ACCESS|CHANGE> <selector:offset> <hex-length> [ONCE]";
+			RemoteWatchpoint watchpoint;
+			watchpoint.id = remote_next_watchpoint_id++;
+			watchpoint.mode = mode;
+			watchpoint.address = static_cast<uint32_t>(first);
+			watchpoint.length = length;
+			watchpoint.once = once;
+			watchpoint.baseline.resize(length);
+			for (uint32_t index = 0; index < length; ++index) {
+				if (mem_readb_checked(static_cast<PhysPt>(first + index),
+				                      &watchpoint.baseline[index]))
+					return "ERR MEMORY_READ";
+			}
+			remote_watchpoints.push_back(watchpoint);
+			remote_debug_enabled.store(true);
+			std::ostringstream out;
+			out << "OK ADDED ID=" << watchpoint.id << " LINEAR=" << std::hex
+			    << std::uppercase << std::setfill('0') << std::setw(8)
+			    << watchpoint.address;
+			return out.str();
+		}
+		return "ERR USAGE DEBUG WATCH (ADD|DELETE|LIST|CLEAR)";
+	}
+
 	if (command == "BREAK") {
 		std::string action, address_text;
 		input >> action >> address_text;
@@ -5221,6 +5410,8 @@ static std::string RemoteExecuteCommand(const std::string &request,
