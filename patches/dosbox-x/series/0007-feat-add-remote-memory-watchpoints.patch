diff --git a/include/paging.h b/include/paging.h
index e7e6974..94f470c 100644
--- a/include/paging.h
+++ b/include/paging.h
@@ -438,25 +438,69 @@ static INLINE PhysPt64 PAGING_GetPhysicalAddress64(const LinearPt linAddr) {
 
 /* Special inlined memory reading/writing */
 
-static INLINE uint8_t mem_readb_inline(const LinearPt address) {
+#if C_DEBUG
+void DEBUG_RemoteMemoryAccess(LinearPt address, unsigned int size,
+                              bool is_write, uint32_t value);
+#endif
+
+/* Instruction fetches use these raw helpers in the normal core. A debugger
+ * data-read watchpoint must not mistake opcode or immediate fetches for data
+ * accesses. */
+static INLINE uint8_t mem_readb_unwatched_inline(const LinearPt address) {
 	const HostPt tlb_addr=get_tlb_read(address);
 	if (tlb_addr) return host_readb(tlb_addr+address);
 	else return (uint8_t)(get_tlb_readhandler(address))->readb(address);
 }
 
-static INLINE uint16_t mem_readw_inline(const LinearPt address) {
+static INLINE uint16_t mem_readw_unwatched_inline(const LinearPt address) {
 	if ((address & 0xfff)<0xfff) {
 		const HostPt tlb_addr=get_tlb_read(address);
 		if (tlb_addr) return host_readw(tlb_addr+address);
 		else return (uint16_t)(get_tlb_readhandler(address))->readw(address);
-	} else return mem_unalignedreadw(address);
+	} else return (uint16_t)(mem_readb_unwatched_inline(address) |
+	                        (uint16_t)(mem_readb_unwatched_inline(address+1u) << 8u));
 }
 
-static INLINE uint32_t mem_readd_inline(const LinearPt address) {
+static INLINE uint32_t mem_readd_unwatched_inline(const LinearPt address) {
 	if ((address & 0xfff)<0xffd) {
 		const HostPt tlb_addr=get_tlb_read(address);
 		if (tlb_addr) return host_readd(tlb_addr+address);
 		else return (uint32_t)(get_tlb_readhandler(address))->readd(address);
+	} else return (uint32_t)mem_readb_unwatched_inline(address) |
+	        ((uint32_t)mem_readb_unwatched_inline(address+1u) << 8u) |
+	        ((uint32_t)mem_readb_unwatched_inline(address+2u) << 16u) |
+	        ((uint32_t)mem_readb_unwatched_inline(address+3u) << 24u);
+}
+
+static INLINE uint8_t mem_readb_inline(const LinearPt address) {
+	const uint8_t value=mem_readb_unwatched_inline(address);
+#if C_DEBUG
+	DEBUG_RemoteMemoryAccess(address,1,false,value);
+#endif
+	return value;
+}
+
+static INLINE uint16_t mem_readw_inline(const LinearPt address) {
+	if ((address & 0xfff)<0xfff) {
+		const HostPt tlb_addr=get_tlb_read(address);
+		const uint16_t value=tlb_addr ? host_readw(tlb_addr+address) :
+		        (uint16_t)(get_tlb_readhandler(address))->readw(address);
+#if C_DEBUG
+		DEBUG_RemoteMemoryAccess(address,2,false,value);
+#endif
+		return value;
+	} else return mem_unalignedreadw(address);
+}
+
+static INLINE uint32_t mem_readd_inline(const LinearPt address) {
+	if ((address & 0xfff)<0xffd) {
+		const HostPt tlb_addr=get_tlb_read(address);
+		const uint32_t value=tlb_addr ? host_readd(tlb_addr+address) :
+		        (uint32_t)(get_tlb_readhandler(address))->readd(address);
+#if C_DEBUG
+		DEBUG_RemoteMemoryAccess(address,4,false,value);
+#endif
+		return value;
 	} else return mem_unalignedreadd(address);
 }
 
@@ -464,6 +508,9 @@ static INLINE void mem_writeb_inline(const LinearPt address,const uint8_t val) {
 	const HostPt tlb_addr=get_tlb_write(address);
 	if (tlb_addr) host_writeb(tlb_addr+address,val);
 	else (get_tlb_writehandler(address))->writeb(address,val);
+#if C_DEBUG
+	DEBUG_RemoteMemoryAccess(address,1,true,val);
+#endif
 }
 
 static INLINE void mem_writew_inline(const LinearPt address,const uint16_t val) {
@@ -471,6 +518,9 @@ static INLINE void mem_writew_inline(const LinearPt address,const uint16_t val)
 		const HostPt tlb_addr=get_tlb_write(address);
 		if (tlb_addr) host_writew(tlb_addr+address,val);
 		else (get_tlb_writehandler(address))->writew(address,val);
+#if C_DEBUG
+		DEBUG_RemoteMemoryAccess(address,2,true,val);
+#endif
 	} else mem_unalignedwritew(address,val);
 }
 
@@ -479,63 +529,90 @@ static INLINE void mem_writed_inline(const LinearPt address,const uint32_t val)
 		const HostPt tlb_addr=get_tlb_write(address);
 		if (tlb_addr) host_writed(tlb_addr+address,val);
 		else (get_tlb_writehandler(address))->writed(address,val);
+#if C_DEBUG
+		DEBUG_RemoteMemoryAccess(address,4,true,val);
+#endif
 	} else mem_unalignedwrited(address,val);
 }
 
 
 static INLINE bool mem_readb_checked(const LinearPt address, uint8_t * const val) {
 	const HostPt tlb_addr=get_tlb_read(address);
+	bool failed=false;
 	if (tlb_addr) {
 		*val=host_readb(tlb_addr+address);
-		return false;
-	} else return (get_tlb_readhandler(address))->readb_checked(address, val);
+	} else failed=(get_tlb_readhandler(address))->readb_checked(address, val);
+#if C_DEBUG
+	if (!failed) DEBUG_RemoteMemoryAccess(address,1,false,*val);
+#endif
+	return failed;
 }
 
 static INLINE bool mem_readw_checked(const LinearPt address, uint16_t * const val) {
 	if ((address & 0xfffu)<0xfffu) {
 		const HostPt tlb_addr=get_tlb_read(address);
+		bool failed=false;
 		if (tlb_addr) {
 			*val=host_readw(tlb_addr+address);
-			return false;
-		} else return (get_tlb_readhandler(address))->readw_checked(address, val);
+		} else failed=(get_tlb_readhandler(address))->readw_checked(address, val);
+#if C_DEBUG
+		if (!failed) DEBUG_RemoteMemoryAccess(address,2,false,*val);
+#endif
+		return failed;
 	} else return mem_unalignedreadw_checked(address, val);
 }
 
 static INLINE bool mem_readd_checked(const LinearPt address, uint32_t * const val) {
 	if ((address & 0xfffu)<0xffdu) {
 		const HostPt tlb_addr=get_tlb_read(address);
+		bool failed=false;
 		if (tlb_addr) {
 			*val=host_readd(tlb_addr+address);
-			return false;
-		} else return (get_tlb_readhandler(address))->readd_checked(address, val);
+		} else failed=(get_tlb_readhandler(address))->readd_checked(address, val);
+#if C_DEBUG
+		if (!failed) DEBUG_RemoteMemoryAccess(address,4,false,*val);
+#endif
+		return failed;
 	} else return mem_unalignedreadd_checked(address, val);
 }
 
 static INLINE bool mem_writeb_checked(const LinearPt address,const uint8_t val) {
 	const HostPt tlb_addr=get_tlb_write(address);
+	bool failed=false;
 	if (tlb_addr) {
 		host_writeb(tlb_addr+address,val);
-		return false;
-	} else return (get_tlb_writehandler(address))->writeb_checked(address,val);
+	} else failed=(get_tlb_writehandler(address))->writeb_checked(address,val);
+#if C_DEBUG
+	if (!failed) DEBUG_RemoteMemoryAccess(address,1,true,val);
+#endif
+	return failed;
 }
 
 static INLINE bool mem_writew_checked(const LinearPt address,const uint16_t val) {
 	if ((address & 0xfffu)<0xfffu) {
 		const HostPt tlb_addr=get_tlb_write(address);
+		bool failed=false;
 		if (tlb_addr) {
 			host_writew(tlb_addr+address,val);
-			return false;
-		} else return (get_tlb_writehandler(address))->writew_checked(address,val);
+		} else failed=(get_tlb_writehandler(address))->writew_checked(address,val);
+#if C_DEBUG
+		if (!failed) DEBUG_RemoteMemoryAccess(address,2,true,val);
+#endif
+		return failed;
 	} else return mem_unalignedwritew_checked(address,val);
 }
 
 static INLINE bool mem_writed_checked(const LinearPt address,const uint32_t val) {
 	if ((address & 0xfffu)<0xffdu) {
 		const HostPt tlb_addr=get_tlb_write(address);
+		bool failed=false;
 		if (tlb_addr) {
 			host_writed(tlb_addr+address,val);
-			return false;
-		} else return (get_tlb_writehandler(address))->writed_checked(address,val);
+		} else failed=(get_tlb_writehandler(address))->writed_checked(address,val);
+#if C_DEBUG
+		if (!failed) DEBUG_RemoteMemoryAccess(address,4,true,val);
+#endif
+		return failed;
 	} else return mem_unalignedwrited_checked(address,val);
 }
 
