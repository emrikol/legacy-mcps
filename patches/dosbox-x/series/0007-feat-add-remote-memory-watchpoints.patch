+	if (remote_debug_stop_reason.load() == REMOTE_STOP_WATCHPOINT)
+		out << " WATCH=" << std::dec << remote_watch_hit_id << std::hex
+		    << " ACCESS=" << (remote_watch_hit_write ? "WRITE" : "READ")
+		    << " ADDRESS=" << std::setw(8) << remote_watch_hit_address
+		    << " SIZE=" << std::dec << remote_watch_hit_size << std::hex
+		    << " VALUE=" << std::setw(8) << remote_watch_hit_value
+		    << " AT=" << std::setw(4) << remote_watch_hit_cs << ":"
+		    << std::setw(8) << remote_watch_hit_eip;
 	return out.str();
 }
 
