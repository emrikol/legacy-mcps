+enum RemoteWatchMode {
+	REMOTE_WATCH_READ,
+	REMOTE_WATCH_WRITE,
+	REMOTE_WATCH_ACCESS,
+	REMOTE_WATCH_CHANGE
+};
+
+struct RemoteWatchpoint {
+	unsigned int id;
+	RemoteWatchMode mode;
+	uint32_t address;
+	uint32_t length;
+	bool once;
+	std::vector<uint8_t> baseline;
+};
+
+static std::vector<RemoteWatchpoint> remote_watchpoints;
+static unsigned int remote_next_watchpoint_id = 1;
+static unsigned int remote_watch_hit_id = 0;
+static uint32_t remote_watch_hit_address = 0;
+static unsigned int remote_watch_hit_size = 0;
+static uint32_t remote_watch_hit_value = 0;
+static bool remote_watch_hit_write = false;
+static uint16_t remote_watch_hit_cs = 0;
+static uint32_t remote_watch_hit_eip = 0;
+static CPU_Decoder *remote_watch_saved_decoder = NULL;
+
 static const char *RemoteStopReasonName(void)
 {
 	switch (remote_debug_stop_reason.load()) {
@@ -376,9 +406,66 @@ static const char *RemoteStopReasonName(void)
 	case REMOTE_STOP_BREAKPOINT: return "BREAKPOINT";
 	case REMOTE_STOP_INTERRUPT: return "INTERRUPT";
 	case REMOTE_STOP_EXCEPTION: return "EXCEPTION";
+	case REMOTE_STOP_WATCHPOINT: return "WATCHPOINT";
 	default: return "NONE";
 	}
 }
+
+static const char *RemoteWatchModeName(RemoteWatchMode mode)
+{
+	switch (mode) {
+	case REMOTE_WATCH_READ: return "READ";
+	case REMOTE_WATCH_WRITE: return "WRITE";
+	case REMOTE_WATCH_ACCESS: return "ACCESS";
+	case REMOTE_WATCH_CHANGE: return "CHANGE";
+	default: return "UNKNOWN";
+	}
+}
+
+/** Observe a completed CPU memory access. The normal core calls this from the
+ * paging fast path, while its instruction-fetch helpers deliberately bypass
+ * it so READ means data read rather than code execution. */
+void DEBUG_RemoteMemoryAccess(LinearPt address, unsigned int size,
+                              bool is_write, uint32_t value)
+{
+	if (remote_watchpoints.empty() ||
+	    (remote_debug_stopped.load() && !remote_watch_step_active)) return;
+	const uint64_t access_end = (uint64_t)address + size;
+	for (size_t index = 0; index < remote_watchpoints.size(); ++index) {
+		RemoteWatchpoint &watchpoint = remote_watchpoints[index];
+		const uint64_t watch_end = (uint64_t)watchpoint.address + watchpoint.length;
+		if (access_end <= watchpoint.address || address >= watch_end) continue;
+
+		bool matches = watchpoint.mode == REMOTE_WATCH_ACCESS ||
+		               (watchpoint.mode == REMOTE_WATCH_READ && !is_write) ||
+		               (watchpoint.mode == REMOTE_WATCH_WRITE && is_write);
+		if (watchpoint.mode == REMOTE_WATCH_CHANGE && is_write) {
+			for (unsigned int byte = 0; byte < size; ++byte) {
+				const uint64_t byte_address = (uint64_t)address + byte;
+				if (byte_address < watchpoint.address || byte_address >= watch_end) continue;
+				const size_t baseline_index =
+				        static_cast<size_t>(byte_address - watchpoint.address);
+				const uint8_t new_value = static_cast<uint8_t>(value >> (byte * 8U));
+				if (watchpoint.baseline[baseline_index] != new_value) matches = true;
+				watchpoint.baseline[baseline_index] = new_value;
+			}
+		}
+		if (!matches || remote_watch_pending.load()) continue;
+
+		remote_watch_hit_id = watchpoint.id;
+		remote_watch_hit_address = address;
+		remote_watch_hit_size = size;
+		remote_watch_hit_value = value;
+		remote_watch_hit_write = is_write;
+		remote_watch_hit_cs = SegValue(cs);
+		remote_watch_hit_eip = reg_eip;
+		remote_debug_stop_reason.store(REMOTE_STOP_WATCHPOINT);
+		remote_watch_pending.store(true);
+		CPU_Cycles = 0;
+		if (watchpoint.once) remote_watchpoints.erase(remote_watchpoints.begin() + index);
+		return;
+	}
+}
 static bool check_rescroll = false;
 
 static FPU_rec oldfpu;
@@ -4749,6 +4836,14 @@ static std::string RemoteRegisterState(void)
 	if (remote_debug_stop_reason.load() == REMOTE_STOP_EXCEPTION)
 		out << " EXCEPTION=" << std::setw(2) << remote_exception_vector.load()
